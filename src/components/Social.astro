---
import { site } from '../data/site';
/** "Follow us" with Instagram + TikTok icons and handles. */
interface Props { light?: boolean; center?: boolean; }
const { light = false, center = false } = Astro.props;
---
<div class:list={['social', { light, center }]}>
  <span class="social__label">Follow us</span>
  <a class="social__link" href={site.socials.instagram} target="_blank" rel="noopener" aria-label={`Instagram ${site.igHandle}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/></svg>
    <span>{site.igHandle}</span>
  </a>
  <a class="social__link" href={site.socials.tiktok} target="_blank" rel="noopener" aria-label={`TikTok ${site.tiktokHandle}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M13.2 3h2.4a5.6 5.6 0 0 0 4.4 4.3v2.5a8 8 0 0 1-4.4-1.4v6.2a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v2.6a3 3 0 1 0 2.1 2.9V3Z" fill="currentColor"/></svg>
    <span>{site.tiktokHandle}</span>
  </a>
</div>

<style>
  .social { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .social.center { justify-content: center; }
  .social__label { font-family: var(--display); font-weight: 800; font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim); }
  .social__link { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.9rem; border: 1px solid var(--card-brd-hi); border-radius: 999px; color: var(--ink); font-weight: 600; font-size: 0.85rem; transition: color 0.2s, border-color 0.2s, background 0.2s; }
  .social__link:hover { color: var(--orchid-deep); border-color: var(--orchid); background: var(--bg-lav); }
  .social.light .social__label { color: rgba(255,255,255,0.7); }
  .social.light .social__link { color: #fff; border-color: rgba(255,255,255,0.4); }
  .social.light .social__link:hover { background: rgba(255,255,255,0.15); border-color: #fff; color: #fff; }
</style>
