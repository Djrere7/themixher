---
/** Decorative tropical hibiscus bloom (brand accent). */
interface Props { size?: number; color?: string; className?: string; spin?: boolean; }
const { size = 120, color = 'var(--orchid)', className = '', spin = false } = Astro.props;
---
<div class:list={['flower', className, { spin }]} style={`--f:${size}px; --fc:${color}`} aria-hidden="true">
  <svg viewBox="0 0 100 100">
    <g>
      {[0, 72, 144, 216, 288].map((a) => (
        <path
          d="M50 50 C 34 36, 34 8, 50 6 C 66 8, 66 36, 50 50 Z"
          fill="var(--fc)"
          transform={`rotate(${a} 50 50)`}
          opacity="0.92"
        />
      ))}
      <circle cx="50" cy="50" r="9" fill="var(--orange)" />
      <circle cx="50" cy="50" r="3.5" fill="#fff" opacity="0.85" />
    </g>
  </svg>
</div>

<style>
  .flower { width: var(--f); height: var(--f); line-height: 0; }
  .flower svg { width: 100%; height: 100%; display: block; filter: drop-shadow(0 6px 14px rgba(117,56,234,0.28)); }
  .flower.spin svg { animation: fspin 26s linear infinite; }
  @keyframes fspin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .flower.spin svg { animation: none; } }
</style>
