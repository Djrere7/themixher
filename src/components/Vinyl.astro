---
/** Decorative spinning vinyl record (DJ element). */
interface Props { size?: number; className?: string; }
const { size = 140, className = '' } = Astro.props;
---
<div class:list={['vinyl', className]} style={`--v:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="vinyl__disc">
    <defs>
      <radialGradient id="vg" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#2a1226" />
        <stop offset="100%" stop-color="#0e0512" />
      </radialGradient>
    </defs>
    <circle cx="100" cy="100" r="98" fill="url(#vg)" />
    {[92, 84, 76, 68, 60, 52].map((r) => (
      <circle cx="100" cy="100" r={r} fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
    ))}
    <circle cx="100" cy="100" r="34" fill="var(--orchid)" />
    <circle cx="100" cy="100" r="34" fill="none" stroke="var(--orange)" stroke-width="2" />
    <circle cx="100" cy="100" r="6" fill="#0e0512" />
    <path d="M100 66 a34 34 0 0 1 0 68" fill="none" stroke="var(--orange)" stroke-width="3" opacity="0.7" />
  </svg>
</div>

<style>
  .vinyl { width: var(--v); height: var(--v); }
  .vinyl__disc { width: 100%; height: 100%; animation: vspin 8s linear infinite; }
  @keyframes vspin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .vinyl__disc { animation: none; } }
</style>
