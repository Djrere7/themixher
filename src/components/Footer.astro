---
import Wordmark from './Wordmark.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
const socials = [
  { label: 'Instagram', href: site.socials.instagram },
  { label: 'TikTok', href: site.socials.tiktok },
  { label: 'YouTube', href: site.socials.youtube },
  { label: 'Facebook', href: site.socials.facebook },
];
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__cta card" id="join-list" data-reveal>
      <div>
        <p class="kicker">Stay in the loop</p>
        <h2 class="fancy">Get on the <span class="grad">list.</span></h2>
        <p class="ft__lead">New events, DJ callouts, and community drops — first, straight to your inbox.</p>
      </div>
      <form class="ft__form" data-newsletter>
        <input type="email" name="email" required placeholder="your@email.com" aria-label="Email address" />
        <button type="submit" class="btn btn-primary">Sign up</button>
      </form>
    </div>

    <div class="ft__grid">
      <div class="ft__brand">
        <Wordmark height={64} />
        <p class="ft__mission">{site.tagline}</p>
        <div class="ft__socials">
          {socials.map((s) => <a href={s.href} target="_blank" rel="noopener" class="ft__social">{s.label}</a>)}
        </div>
      </div>

      <nav class="ft__col" aria-label="Footer">
        <h3 class="ft__h">Explore</h3>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="ft__col">
        <h3 class="ft__h">Get involved</h3>
        <a href={site.donateUrl}>Donate</a>
        <a href={site.sponsorUrl}>Sponsor MixHer</a>
        <a href={site.applyUrl}>Apply to perform</a>
        <a href="/events">Events</a>
      </div>

      <div class="ft__col">
        <h3 class="ft__h">Contact</h3>
        <a href={site.emailHref}>{site.email}</a>
        <a href={site.phoneHref}>{site.phone}</a>
        <span class="ft__addr">{site.address}</span>
      </div>
    </div>

    <hr class="rule" />
    <div class="ft__base">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="ft__np">{site.nonprofit}</p>
    </div>
  </div>
</footer>

<style>
  .ft { padding-block: clamp(3rem, 7vw, 5.5rem) 2.5rem; margin-top: 1rem; }
  .ft__cta { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center; background: linear-gradient(120deg, var(--bg-lav), #fff); border-color: var(--card-brd-hi); margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .ft__cta h2 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0.2rem 0; }
  .ft__lead { color: var(--muted); margin: 0; }
  .ft__form { display: flex; gap: 0.6rem; }
  .ft__form input { flex: 1; min-width: 0; padding: 0.85rem 1.1rem; border-radius: 999px; background: #fff; border: 1px solid var(--card-brd-hi); color: var(--ink); font-family: var(--body); font-size: 0.95rem; }
  .ft__form input:focus { outline: none; border-color: var(--orchid); }

  .ft__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: 2rem; }
  .ft__mission { color: var(--muted); margin: 1rem 0 1.2rem; max-width: 30ch; font-weight: 500; }
  .ft__socials { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ft__social { font-size: 0.82rem; padding: 0.4rem 0.8rem; border: 1px solid var(--card-brd); border-radius: 999px; color: var(--muted); transition: color 0.2s, border-color 0.2s; }
  .ft__social:hover { color: var(--ink); border-color: var(--orchid); }
  .ft__col { display: flex; flex-direction: column; gap: 0.55rem; }
  .ft__h { font-family: var(--sans); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--orchid-deep); margin: 0 0 0.4rem; }
  .ft__col a, .ft__addr { color: var(--muted); font-size: 0.9rem; transition: color 0.2s ease; }
  .ft__col a:hover { color: var(--ink); }
  .ft__base { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-top: 1.4rem; color: var(--dim); font-size: 0.8rem; }

  @media (max-width: 860px) { .ft__cta { grid-template-columns: 1fr; } .ft__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ft__grid { grid-template-columns: 1fr; } .ft__form { flex-direction: column; } }
</style>

<script>
  document.querySelector('[data-newsletter]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    form.innerHTML = '<p style="margin:0;color:var(--orchid-deep);font-family:var(--sans);font-weight:800;letter-spacing:0.04em;font-size:1.15rem;">YOU’RE ON THE LIST ✦</p>';
  });
</script>
