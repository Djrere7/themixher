---
import Wordmark from './Wordmark.astro';
import Social from './Social.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__cta card" id="join-list" data-reveal>
      <div>
        <p class="kicker">The newsletter</p>
        <h2 class="fancy">Never miss a <span class="grad">moment.</span></h2>
        <p class="ft__lead">New events, DJ callouts, and MixHer moments — first, straight to your inbox.</p>
      </div>
      <form class="ft__form" data-newsletter data-gf={site.googleForm.action} data-gf-email={site.googleForm.entries.email} data-gf-type={site.googleForm.entries.type}>
        <input type="email" name="email" required placeholder="your@email.com" aria-label="Email address" />
        <button type="submit" class="btn btn-primary">Join</button>
      </form>
    </div>

    <div class="ft__grid">
      <div class="ft__brand">
        <Wordmark height={64} />
        <p class="ft__mission">The national hub for female DJs — events, networking, community, and education.</p>
        <Social />
      </div>

      <nav class="ft__col" aria-label="Explore">
        <h3 class="ft__h">Explore</h3>
        {nav.map((item) => (
          <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>{item.label}{item.external && ' ↗'}</a>
        ))}
      </nav>

      <div class="ft__col">
        <h3 class="ft__h">Take action</h3>
        <a href={site.donateUrl} target="_blank" rel="noopener">Donate</a>
        <a href={site.joinUrl}>Join the DJ Network</a>
        <a href={site.sponsorUrl}>Sponsor MixHer</a>
        <a href={site.firstSpinUrl} target="_blank" rel="noopener">Fund First Spin DJ Bootcamp ↗</a>
        <a href={site.bringUrl}>Bring MixHer to Your City</a>
      </div>

      <div class="ft__col">
        <h3 class="ft__h">Contact</h3>
        <a href={site.emailHref}>{site.email}</a>
        <span class="ft__addr">{site.address.city}, {site.address.region} · Nationwide</span>
      </div>
    </div>

    <section class="ft__np" aria-label="Nonprofit information" data-reveal>
      <h3 class="ft__h">Nonprofit information</h3>
      <dl class="ft__npgrid">
        <div><dt>Legal name</dt><dd>{site.legalName}</dd></div>
        <div><dt>EIN</dt><dd>{site.ein}</dd></div>
        <div><dt>501(c)(3) status</dt><dd>Tax-exempt nonprofit organization</dd></div>
        <div><dt>Primary website</dt><dd>TheMixHer.org</dd></div>
        <div class="ft__npaddr"><dt>Address</dt><dd>{site.addressLine}</dd></div>
      </dl>
      <p class="ft__nptax">{site.legalName} is a registered 501(c)(3) nonprofit. {site.taxLine}</p>
    </section>

    <hr class="rule" />
    <div class="ft__base">
      <p>© {year} {site.legalName}. All rights reserved. · {site.nonprofit}</p>
      <p class="ft__legal"><a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms</a></p>
    </div>
  </div>
</footer>

<style>
  .ft { padding-block: clamp(3rem, 7vw, 5.5rem) 2.5rem; margin-top: 1rem; }
  .ft__cta { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center; background: linear-gradient(120deg, var(--bg-lav), #fff); border-color: var(--card-brd-hi); margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .ft__cta h2 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0.2rem 0; }
  .ft__lead { color: var(--muted); margin: 0; }
  .ft__form { display: flex; gap: 0.6rem; }
  .ft__form input { flex: 1; min-width: 0; padding: 0.85rem 1.1rem; border-radius: 999px; background: #fff; border: 1px solid var(--card-brd-hi); color: var(--ink); font-family: var(--body); font-size: 0.95rem; }
  .ft__form input:focus { outline: none; border-color: var(--orchid); }

  .ft__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: 2rem; }
  .ft__mission { color: var(--muted); margin: 1rem 0 1.2rem; max-width: 32ch; font-weight: 500; }
  .ft__socials { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ft__social { font-size: 0.82rem; padding: 0.4rem 0.8rem; border: 1px solid var(--card-brd); border-radius: 999px; color: var(--muted); transition: color 0.2s, border-color 0.2s; }
  .ft__social:hover { color: var(--ink); border-color: var(--orchid); }
  .ft__col { display: flex; flex-direction: column; gap: 0.55rem; }
  .ft__h { font-family: var(--display); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--orchid-deep); margin: 0 0 0.4rem; }
  .ft__col a, .ft__addr { color: var(--muted); font-size: 0.9rem; transition: color 0.2s ease; }
  .ft__col a:hover { color: var(--ink); }
  .ft__base { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-top: 1.4rem; color: var(--dim); font-size: 0.8rem; }
  .ft__legal a { color: var(--dim); } .ft__legal a:hover { color: var(--ink); }

  .ft__np { margin-top: clamp(2.2rem, 5vw, 3.2rem); padding: clamp(1.2rem, 3vw, 1.6rem) clamp(1.3rem, 3vw, 1.8rem); background: var(--bg-2, #faf6fe); border: 1px solid var(--card-brd); border-radius: var(--radius); }
  .ft__npgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem 2.4rem; margin: 0.9rem 0 0; }
  .ft__npgrid dt { font-family: var(--display); font-weight: 800; font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); margin-bottom: 0.1rem; }
  .ft__npgrid dd { margin: 0; color: var(--ink); font-size: 0.9rem; font-weight: 600; }
  .ft__npaddr { grid-column: 1 / -1; }
  .ft__nptax { margin: 1rem 0 0; color: var(--muted); font-size: 0.8rem; }

  @media (max-width: 860px) { .ft__cta { grid-template-columns: 1fr; } .ft__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ft__grid { grid-template-columns: 1fr; } .ft__form { flex-direction: column; } .ft__npgrid { grid-template-columns: 1fr; } }
</style>

<script>
  const f = document.querySelector('[data-newsletter]') as HTMLFormElement | null;
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (f.querySelector('input') as HTMLInputElement)?.value || '';
    const gf = f.dataset.gf;
    if (gf) {
      const out = new FormData();
      if (f.dataset.gfEmail) out.append(f.dataset.gfEmail, email);
      if (f.dataset.gfType) out.append(f.dataset.gfType, 'Newsletter');
      fetch(gf, { method: 'POST', mode: 'no-cors', body: out }).catch(() => {});
    } else {
      window.location.href = `mailto:info@themixher.org?subject=${encodeURIComponent('[MixHer] Newsletter signup')}&body=${encodeURIComponent('Please add me: ' + email)}`;
    }
    f.innerHTML = '<p style="margin:0;color:var(--orchid-deep);font-family:var(--sans);font-weight:800;">YOU’RE IN ✦</p>';
  });
</script>
