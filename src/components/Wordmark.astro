---
/** The MixHer logo. Uses the real brand mark at /brand/mixher-logo.png. */
interface Props { height?: number; footer?: boolean; }
const { height = 48 } = Astro.props;
---
<a class="wm" href="/" aria-label="The MixHer — home">
  <img src="/brand/mixher-logo.png" alt="The MixHer" width="900" height="583" style={`height:${height}px`} />
</a>

<style>
  .wm { display: inline-flex; align-items: center; line-height: 0; }
  .wm img { width: auto; display: block; }
</style>
