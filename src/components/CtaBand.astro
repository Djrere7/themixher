---
import { site } from '../data/site';
interface Props {
  heading?: string;
  sub?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading = 'Ready to lead the vibe with us?',
  sub = 'Whether you spin, sponsor, or show up — there’s a place for you. All vibes welcome.',
  primaryLabel = 'Become a sponsor',
  primaryHref = site.sponsorUrl,
  secondaryLabel = 'Join the community',
  secondaryHref = '/ply',
} = Astro.props;
---
<section class="section-pad">
  <div class="wrap">
    <div class="band" data-reveal>
      <div class="band__glow" aria-hidden="true"></div>
      <h2 class="fancy band__h" set:html={heading} />
      <p class="band__sub">{sub}</p>
      <div class="band__btns">
        <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>
        <a href={secondaryHref} class="btn btn-ghost">{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative; overflow: hidden; text-align: center;
    padding: clamp(2.5rem, 7vw, 5rem) var(--gutter);
    border-radius: var(--radius-lg);
    border: 1px solid var(--card-brd-hi);
    background: linear-gradient(120deg, var(--bg-lav), #fff 55%, rgba(254,154,0,0.08));
    box-shadow: var(--shadow);
  }
  .band__glow { position: absolute; width: 460px; height: 460px; top: -190px; left: 50%; margin-left: -230px; border-radius: 50%; background: radial-gradient(circle, rgba(203,108,230,0.28), transparent 70%); pointer-events: none; }
  .band__h { font-size: clamp(2rem, 6vw, 3.8rem); position: relative; margin: 0; }
  .band__sub { color: var(--muted); max-width: 52ch; margin: 0.7rem auto 1.8rem; position: relative; }
  .band__btns { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; position: relative; }
</style>
