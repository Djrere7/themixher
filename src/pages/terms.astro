---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---
<Base title="Terms" description="Terms of use for the MixHer website.">
  <PageHeader kicker="Legal" title="Terms of Use" />
  <section class="section-pad"><div class="wrap narrow legal">
    <p>By using themixher.org, you agree to these terms.</p>
    <h2>Use of the site</h2>
    <p>This site is provided for information about MixHer’s events, DJ Network, sponsorships, and First Spin DJ Bootcamp. Content is owned by MixHer Inc. and may not be reproduced without permission.</p>
    <h2>Events &amp; tickets</h2>
    <p>Event details are subject to change. Ticket sales may be handled by third-party platforms with their own terms.</p>
    <h2>Contact</h2>
    <p>Questions about these terms? Email <a href={site.emailHref}>{site.email}</a>.</p>
    <p class="legal__note">This is a general template. Consult counsel to tailor it before launch.</p>
  </div></section>
</Base>
<style>
  .legal { color: var(--muted); line-height: 1.75; }
  .legal h2 { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 1.3rem; color: var(--ink); margin: 1.6rem 0 0.4rem; }
  .legal a { color: var(--orchid-deep); }
  .legal__note { font-size: 0.85rem; color: var(--dim); margin-top: 2rem; }
</style>
