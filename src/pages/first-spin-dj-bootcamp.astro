---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, firstSpinLearn } from '../data/site';
---
<Base
  title="First Spin DJ Bootcamp"
  fullTitle="First Spin DJ Bootcamp | Youth DJ Lessons and Mentorship"
  description="First Spin DJ Bootcamp provides no-cost DJ education, mentorship, and entrepreneurship exposure for youth in underserved communities. Fund a student today."
>
  <PageHeader
    kicker="First Spin · DJ Bootcamp"
    title={`Every legend had a<br/><span class='grad'>first spin.</span>`}
    lead="First Spin DJ Bootcamp provides no-cost DJ education for youth in underserved communities — equipment, music programming, technical skills, creativity, mentorship, and entrepreneurship."
    serif={true}
  />

  <!-- Logo + intro -->
  <section class="section-pad">
    <div class="wrap split">
      <div class="split__media" data-reveal><Media src="/img/booth2.jpg" alt="First Spin DJ Bootcamp student learning DJ equipment" ratio="4 / 3" /></div>
      <div class="split__text" data-reveal>
        <img src="/img/firstspin-logo.png" alt="First Spin DJ Bootcamp logo" class="fs-logo" width="220" height="120" />
        <h2 class="fancy">Access, not <span class="grad">barriers.</span></h2>
        <p>First Spin removes the biggest barrier between a young person and the decks — access. Using proceeds from MixHer events, we deliver free, professional DJ education and put real gear in students’ hands.</p>
        <p><b>Who it serves:</b> youth in underserved communities, learning skills that open real doors.</p>
      </div>
    </div>
  </section>

  <!-- What they learn -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head"><p class="spaced" data-reveal>What students learn</p><h2 class="display" data-reveal>From zero to first mix</h2></div>
      <div class="grid grid-3">
        {firstSpinLearn.map((l, i) => (
          <div class="card learn" data-reveal><span class="learn__no">0{i + 1}</span><h3>{l}</h3></div>
        ))}
      </div>
    </div>
  </section>

  <!-- How funding helps -->
  <section class="section-pad">
    <div class="wrap narrow" style="text-align:center">
      <p class="spaced center" data-reveal>How funding helps</p>
      <h2 class="fancy" data-reveal>Fund the next generation of DJs.</h2>
      <p class="lead" data-reveal>As a registered 501(c)(3) nonprofit, MixHer reinvests directly into First Spin. Every dollar buys equipment, funds instruction, and opens a door. {site.taxLine}</p>
    </div>
  </section>

  <!-- Ways to give -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="grid grid-4">
        <div class="card give" data-reveal><h3 class="give__h grad">Sponsor a student</h3><p>Cover a young person’s full bootcamp experience.</p><a href={site.donateUrl} class="btn btn-primary">Donate</a></div>
        <div class="card give" data-reveal><h3 class="give__h grad">Fund a workshop</h3><p>Underwrite a full class of aspiring DJs.</p><a href={site.sponsorUrl} class="btn btn-ghost">Sponsor</a></div>
        <div class="card give" data-reveal><h3 class="give__h grad">Become a mentor</h3><p>Share your skills with the next generation.</p><a href="/contact?reason=mentor" class="btn btn-ghost">Volunteer</a></div>
        <div class="card give" data-reveal><h3 class="give__h grad">Grants &amp; foundations</h3><p>Partner with a measurable youth-education initiative.</p><a href="/contact?reason=grant" class="btn btn-ghost">Contact us</a></div>
      </div>
    </div>
  </section>

  <CtaBand heading="Support stages, access & education." sub="Partner with a nonprofit platform shaping the future of DJ culture." primaryLabel="Donate to First Spin" primaryHref={site.donateUrl} secondaryLabel="Sponsor First Spin" secondaryHref={site.sponsorUrl} />
</Base>

<style>
  .sec-head .spaced { display: inline-block; margin-bottom: 0.7rem; }
  .center { display: block; text-align: center; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split__text p { color: var(--muted); max-width: 52ch; }
  .fs-logo { max-width: 220px; height: auto; margin-bottom: 0.6rem; }
  @media (max-width: 840px) { .split { grid-template-columns: 1fr; } }

  .learn { display: flex; align-items: center; gap: 0.9rem; }
  .learn__no { font-family: var(--display); font-weight: 800; font-size: 1.6rem; color: var(--orange); }
  .learn h3 { font-family: var(--display); font-weight: 800; font-size: 1.15rem; text-transform: uppercase; margin: 0; }

  .lead { color: var(--muted); font-size: 1.1rem; max-width: 60ch; margin: 1rem auto 0; }
  .give { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  .give__h { font-family: var(--display); font-weight: 800; font-size: 1.35rem; text-transform: uppercase; margin: 0; }
  .give p { color: var(--muted); margin: 0 0 0.6rem; font-size: 0.92rem; flex: 1; }
</style>
