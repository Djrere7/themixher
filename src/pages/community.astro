---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, community } from '../data/site';
---
<Base title="DJ Community" description="The hub for female DJs — join the MixHer WhatsApp community, find performance opportunities, mentorship, resources, and First Spin DJ education.">
  <PageHeader
    kicker="For female DJs"
    title={`Your seat at<br/>the <span class='grad'>decks.</span>`}
    lead="MixHer is a home base for women behind the decks — a place to get booked, level up, connect with the industry, and never spin alone."
  />

  <!-- Join banner -->
  <section class="section-pad">
    <div class="wrap">
      <div class="join card" data-reveal>
        <div>
          <p class="kicker">Start here</p>
          <h2 class="display">Join the <span class="grad-y">community</span></h2>
          <p class="join__p">
            Our WhatsApp group is where the movement lives day to day — gig callouts, gear talk, advice,
            hype, and real-time support between women who get it. Free to join.
          </p>
        </div>
        <div class="join__btns">
          <a href={site.whatsappUrl} class="btn btn-primary">Join WhatsApp community</a>
          <a href={site.applyUrl} class="btn btn-ghost">Apply to perform</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker" data-reveal>What you get</p>
        <h2 class="display" data-reveal>Everything a working DJ needs</h2>
      </div>
      <div class="grid grid-3">
        {community.map((c) => (
          <div class="card feat" data-reveal>
            <h3 class="feat__title">{c.title}</h3>
            <p class="feat__blurb">{c.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section-pad steps">
    <div class="wrap">
      <div class="sec-head"><p class="kicker" data-reveal>How it works</p>
      <h2 class="display" data-reveal>From curious to booked</h2></div>
      <div class="grid grid-4">
        <div class="step" data-reveal><span class="step__no">01</span><h3>Join</h3><p>Hop into the WhatsApp community and introduce yourself.</p></div>
        <div class="step" data-reveal><span class="step__no">02</span><h3>Apply</h3><p>Submit your mixes and info to be considered for showcases.</p></div>
        <div class="step" data-reveal><span class="step__no">03</span><h3>Perform</h3><p>Get slotted for MixHer events, mixers, and brand activations.</p></div>
        <div class="step" data-reveal><span class="step__no">04</span><h3>Grow</h3><p>Network, mentor, and get booked — again and again.</p></div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Ready to spin with us?"
    sub="Join the community today — it’s free, and it’s where every MixHer opportunity starts."
    primaryLabel="Join WhatsApp"
    primaryHref={site.whatsappUrl}
    secondaryLabel="Explore First Spin"
    secondaryHref="/first-spin"
  />
</Base>

<style>
  .join { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: center; background: linear-gradient(120deg, rgba(117,56,234,0.18), rgba(255,79,176,0.08)); border-color: var(--card-brd-hi); }
  .join__p { color: var(--muted); margin: 0; max-width: 48ch; }
  .join__btns { display: flex; flex-direction: column; gap: 0.7rem; }
  .join__btns .btn { width: 100%; }
  @media (max-width: 780px) { .join { grid-template-columns: 1fr; } }

  .feat { display: flex; flex-direction: column; gap: 0.4rem; }
  .feat__title { font-family: var(--display); font-size: 1.6rem; letter-spacing: 0.03em; text-transform: uppercase; margin: 0; color: var(--lavender); }
  .feat__blurb { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .steps { border-top: 1px solid var(--card-brd); }
  .step { padding: 0.4rem 0; }
  .step__no { font-family: var(--display); font-size: 2.4rem; color: var(--pink-hot); letter-spacing: 0.05em; }
  .step h3 { font-family: var(--display); font-size: 1.5rem; letter-spacing: 0.04em; text-transform: uppercase; margin: 0.2rem 0 0.3rem; }
  .step p { color: var(--muted); margin: 0; font-size: 0.9rem; }
</style>
