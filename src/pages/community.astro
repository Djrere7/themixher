---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Media from '../components/Media.astro';
import { site, community } from '../data/site';
---
<Base title="Community" description="The MixHer community for female DJs — join the group, find performance opportunities, mentorship, resources, and a network that has your back.">
  <PageHeader
    kicker="For female DJs"
    title={`Your seat at<br/>the <span class='grad'>decks.</span>`}
    lead="MixHer is a home base for women behind the decks — a place to get booked, level up, connect with the industry, and never spin alone."
  />

  <!-- Join banner -->
  <section class="section-pad">
    <div class="wrap">
      <div class="join card" data-reveal>
        <div class="join__content">
          <p class="kicker">Start here</p>
          <h2 class="fancy">Join the <span class="grad">community.</span></h2>
          <p class="join__p">
            Our group chat is where the movement lives day to day — gig callouts, gear talk, advice,
            hype, and real-time support between women who get it. Free to join.
          </p>
          <div class="join__btns">
            <a href={site.communityUrl} class="btn btn-primary">Join the community</a>
            <a href={site.applyUrl} class="btn btn-ghost">Apply to perform</a>
          </div>
        </div>
        <div class="join__media"><Media src="/img/dj-spin.jpg" alt="A female DJ spinning at a MixHer event" ratio="1 / 1" /></div>
      </div>
    </div>
  </section>

  <!-- What you get -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker" data-reveal>What you get</p>
        <h2 class="display" data-reveal>Everything a working DJ needs</h2>
      </div>
      <div class="grid grid-3">
        {community.map((c) => (
          <div class="card feat" data-reveal>
            <h3 class="feat__title">{c.title}</h3>
            <p class="feat__blurb">{c.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community photo strip -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head"><p class="kicker" data-reveal>The vibe</p>
      <h2 class="fancy" data-reveal>You belong here</h2></div>
      <div class="grid grid-3 strip">
        <Media src="/img/laugh.jpg" alt="Friends laughing at a MixHer event" ratio="1 / 1" />
        <Media src="/img/group2.jpg" alt="The MixHer community" ratio="1 / 1" />
        <Media src="/img/booth2.jpg" alt="MixHer members together" ratio="1 / 1" />
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head"><p class="kicker" data-reveal>How it works</p>
      <h2 class="fancy" data-reveal>From curious to booked</h2></div>
      <div class="grid grid-4">
        <div class="step" data-reveal><span class="step__no">01</span><h3>Join</h3><p>Hop into the community and introduce yourself.</p></div>
        <div class="step" data-reveal><span class="step__no">02</span><h3>Apply</h3><p>Submit your mixes and info to be considered for showcases.</p></div>
        <div class="step" data-reveal><span class="step__no">03</span><h3>Perform</h3><p>Get slotted for MixHer events, mixers, and activations.</p></div>
        <div class="step" data-reveal><span class="step__no">04</span><h3>Grow</h3><p>Network, mentor, and get booked — again and again.</p></div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Ready to spin with us?"
    sub="Join the community today — it’s free, and it’s where every MixHer opportunity starts."
    primaryLabel="Join the community"
    primaryHref={site.communityUrl}
    secondaryLabel="See upcoming events"
    secondaryHref="/events"
  />
</Base>

<style>
  .join { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; background: linear-gradient(120deg, var(--bg-lav), #fff); border-color: var(--card-brd-hi); }
  .join h2 { margin: 0.2rem 0; }
  .join__p { color: var(--muted); margin: 0 0 1.2rem; max-width: 46ch; }
  .join__btns { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .join__media { border-radius: var(--radius); overflow: hidden; }
  @media (max-width: 780px) { .join { grid-template-columns: 1fr; } .join__media { order: -1; max-width: 320px; } }

  .strip { margin-top: 0.5rem; }

  .sec-head .kicker { margin-bottom: 0.7rem; }
  .feat { display: flex; flex-direction: column; gap: 0.4rem; }
  .feat__title { font-family: var(--sans); font-weight: 800; font-size: 1.4rem; text-transform: uppercase; margin: 0; color: var(--orchid-deep); }
  .feat__blurb { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .step { padding: 0.4rem 0; }
  .step__no { font-family: var(--display); font-weight: 700; font-size: 2.2rem; color: var(--orange); }
  .step h3 { font-family: var(--sans); font-weight: 800; font-size: 1.4rem; text-transform: uppercase; margin: 0.2rem 0 0.3rem; }
  .step p { color: var(--muted); margin: 0; font-size: 0.9rem; }
</style>
