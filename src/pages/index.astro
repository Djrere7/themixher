---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, experiences, pillars, paths, stats, ticker, press } from '../data/site';
---
<Base>
  <!-- ======================= HERO ======================= -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="kicker" data-reveal>The nonprofit platform for female DJs</p>
      <h1 class="fancy hero__h" data-reveal>
        Female DJs<br />lead the <span class="grad-o">vibe.</span>
      </h1>
      <p class="hero__script script" data-reveal>All vibes welcome.</p>
      <p class="hero__sub" data-reveal>{site.coreSentence}</p>
      <div class="hero__btns" data-reveal>
        <a href={site.donateUrl} class="btn btn-primary">Donate</a>
        <a href={site.sponsorUrl} class="btn btn-purple">Become a sponsor</a>
        <a href="/ply" class="btn btn-ghost">Join the community</a>
      </div>
      <div class="hero__stats" data-reveal>
        {stats.map((s) => (
          <div class="hero__stat">
            <span class="stat__num grad">{s.num}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="mq-band"><Marquee items={ticker} /></div>

  <!-- ======================= MORE THAN A PARTY ======================= -->
  <section class="section-pad">
    <div class="wrap intro">
      <div class="intro__text">
        <p class="kicker" data-reveal>More than a party</p>
        <h2 class="fancy" data-reveal>A movement for women <span class="grad">behind the decks.</span></h2>
        <p data-reveal>
          MixHer is more than events — it’s a celebration. We spotlight the trailblazers who shatter
          glass ceilings on turntables and the innovators weaving sonic tapestries that move us.
        </p>
        <p data-reveal>
          Through recognition, access, and support, MixHer creates a platform for their artistry, a
          network for their growth, and a community that champions their success. We start in Miami,
          and we’re taking it nationwide.
        </p>
        <a href="/about" class="btn btn-ghost" data-reveal>Our story</a>
      </div>
      <div class="intro__media" data-reveal>
        <Media label="MixHer Live" ratio="3 / 4" />
      </div>
    </div>
  </section>

  <!-- ======================= THE ECOSYSTEM ======================= -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head center-head">
        <p class="kicker center" data-reveal>The MixHer ecosystem</p>
        <h2 class="display" data-reveal>Three signature experiences</h2>
        <p class="sec-sub" data-reveal>One nonprofit platform, three ways we spotlight female DJs.</p>
      </div>
      <div class="grid grid-3">
        {experiences.map((e) => (
          <a href={e.href} class="card exp" data-reveal style={`--accent:${e.accent}`}>
            <span class="exp__tagline">{e.tagline}</span>
            <h3 class="exp__name">{e.key}</h3>
            <span class="exp__label">{e.label}</span>
            <p class="exp__blurb">{e.blurb}</p>
            <span class="exp__cta">Explore {e.key} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= PILLARS ======================= -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker" data-reveal>What we create opportunity through</p>
        <h2 class="fancy" data-reveal>Music · Culture · Networking · Education</h2>
      </div>
      <div class="grid grid-4">
        {pillars.map((p, i) => (
          <div class="pillar" data-reveal>
            <span class="pillar__no">0{i + 1}</span>
            <h3 class="pillar__name grad">{p.key}</h3>
            <p class="pillar__blurb">{p.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= AUDIENCE PATHS ======================= -->
  <section class="section-pad tint-lav">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker" data-reveal>Find your lane</p>
        <h2 class="display" data-reveal>Everyone has a place here</h2>
      </div>
      <div class="grid grid-3">
        {paths.map((p) => (
          <a href={p.href} class="card path" data-reveal style={`--accent:${p.accent}`}>
            <h3 class="path__title">{p.title}</h3>
            <p class="path__blurb">{p.blurb}</p>
            <span class="path__cta">{p.cta} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= PRESS ======================= -->
  <section class="section-pad logos">
    <div class="wrap">
      <p class="kicker center" data-reveal>As seen in</p>
      <div class="logos__row" data-reveal>
        {press.map((name) => <span class="logos__item">{name}</span>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { position: relative; padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem); overflow: hidden; }
  .hero__glow { position: absolute; top: -14%; right: -8%; width: 62vw; height: 62vw; max-width: 780px; max-height: 780px; background: radial-gradient(circle, rgba(203,108,230,0.24), rgba(254,154,0,0.10) 45%, transparent 70%); pointer-events: none; z-index: 0; }
  .hero__inner { position: relative; z-index: 1; }
  .hero__h { font-size: clamp(3rem, 11vw, 7.5rem); margin: 0.6rem 0 0; }
  .hero__script { font-family: var(--script); font-size: clamp(2.4rem, 6vw, 4.5rem); color: var(--orchid-deep); line-height: 0.8; margin: 0.4rem 0 0.8rem; }
  .hero__sub { color: var(--muted); max-width: 60ch; font-size: 1.05rem; }
  .hero__btns { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.6rem; }
  .hero__stats { display: flex; flex-wrap: wrap; gap: clamp(1.5rem, 5vw, 3.5rem); margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .hero__stat { display: flex; flex-direction: column; gap: 0.1rem; }

  .mq-band { padding-block: 1.3rem; border-block: 1px solid var(--card-brd); background: #fff; }

  .sec-head { margin-bottom: clamp(1.8rem, 4vw, 3rem); }
  .sec-head .kicker { margin-bottom: 0.7rem; }
  .center-head { text-align: center; }
  .sec-sub { color: var(--muted); margin: 0.6rem 0 0; }
  .center { justify-content: center; display: inline-flex; }
  .center-head .kicker { display: inline-flex; }

  .intro { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .intro__text p { color: var(--muted); max-width: 52ch; }
  .intro__text .btn { margin-top: 0.8rem; }
  @media (max-width: 840px) { .intro { grid-template-columns: 1fr; } .intro__media { order: -1; } }

  /* Experience cards */
  .exp { display: flex; flex-direction: column; gap: 0.35rem; border-top: 4px solid var(--accent); }
  .exp__tagline { font-family: var(--script); font-size: 1.6rem; color: var(--accent); line-height: 0.9; }
  .exp__name { font-family: var(--sans); font-weight: 800; font-size: 2rem; text-transform: uppercase; letter-spacing: -0.01em; margin: 0.1rem 0 0; }
  .exp__label { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .exp__blurb { color: var(--muted); margin: 0.5rem 0 0.4rem; flex: 1; font-size: 0.95rem; }
  .exp__cta { font-weight: 700; color: var(--accent); font-size: 0.95rem; }
  .exp:hover .exp__cta span { margin-left: 0.3rem; }

  .pillar { padding: 0.4rem 0; }
  .pillar__no { font-family: var(--serif); font-size: 1.1rem; color: var(--dim); }
  .pillar__name { font-family: var(--sans); font-weight: 800; font-size: 1.9rem; text-transform: uppercase; margin: 0.2rem 0 0.5rem; }
  .pillar__blurb { color: var(--muted); font-size: 0.92rem; margin: 0; }

  .path { display: flex; flex-direction: column; gap: 0.6rem; border-top: 4px solid var(--accent); }
  .path__title { font-family: var(--sans); font-weight: 800; font-size: 1.7rem; text-transform: uppercase; margin: 0; }
  .path__blurb { color: var(--muted); margin: 0; flex: 1; }
  .path__cta { font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent); font-size: 0.9rem; }
  .path:hover .path__cta span { margin-left: 0.3rem; }

  .logos__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2.4rem; margin-top: 1.6rem; }
  .logos__item { font-family: var(--sans); font-weight: 800; font-size: clamp(1rem, 2.2vw, 1.5rem); text-transform: uppercase; color: var(--dim); transition: color 0.2s ease; }
  .logos__item:hover { color: var(--orchid-deep); }
</style>
