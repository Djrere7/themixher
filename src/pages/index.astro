---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Media from '../components/Media.astro';
import Vinyl from '../components/Vinyl.astro';
import Form from '../components/Form.astro';
import Social from '../components/Social.astro';
import { site, proofBar, pillars, founder, sponsors, ticker, events, merch, merchNote } from '../data/site';

const orderHref = (m: any) =>
  `mailto:${site.email}?subject=${encodeURIComponent(`Merch order: ${m.name} (${m.color})`)}&body=${encodeURIComponent(`I'd like to order:\n\n${m.name} — ${m.color}\nSize (S–XXL): \nQuantity: \n\nName:\nShipping address:\n`)}`;

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is MixHer?', acceptedAnswer: { '@type': 'Answer', text: site.whatIs } },
    { '@type': 'Question', name: 'Is MixHer a nonprofit?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — MixHer is a registered 501(c)(3) nonprofit event series and DJ network founded in Miami by DJ ReRe.' } },
    { '@type': 'Question', name: 'How do female DJs join MixHer?', acceptedAnswer: { '@type': 'Answer', text: 'Female DJs request to join the MixHer DJ Network for stages, gig-sharing, industry connections, and brand opportunities. Every request is reviewed.' } },
  ],
};
const links = (p: any) => (p.key === 'FirstSpin' ? site.firstSpinUrl : p.key === 'Network' ? '#djs' : '#events');
const galleryImgs = [
  '/img/mh-network.jpg', '/img/gallery/decks.jpg', '/img/dj-spin.jpg',
  '/img/gallery/squad.jpg', '/img/dj-decks.jpg', '/img/gallery/sammie.jpg',
  '/img/gallery/party.jpg', '/img/gallery/crowd.jpg',
];
const recaps = [
  { src: '/video/recap-brunch.mp4', poster: '/video/recap-brunch-poster.jpg', title: 'Rooftop Brunch & Beats', meta: 'Miami · 12.8.24' },
  { src: '/video/recap-clevelander.mp4', poster: '/video/recap-clevelander-poster.jpg', title: 'Clevelander Rooftop Party', meta: 'South Beach · 12.15.24' },
  { src: '/video/recap-8.mp4', poster: '/video/recap-8-poster.jpg', title: 'MixHer Recap', meta: 'See the vibe' },
  { src: '/video/recap-artbasel.mp4', poster: '/video/recap-artbasel-poster.jpg', title: 'Debut Rooftop Party', meta: 'Art Basel · Miami 2023' },
];
---
<Base schema={[faqSchema]}>
  <!-- HERO -->
  <section class="hero">
    <div class="wc" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="spaced" data-reveal>National 501(c)(3) nonprofit · Female DJ network</p>
        <h1 class="display hero__h" data-reveal>Setting The Tone<br />for female DJs <span class="grad-o">nationwide.</span></h1>
        <p class="hero__script script" data-reveal>Female DJs lead the vibe.</p>
        <p class="hero__sub" data-reveal>{site.hero}</p>
        <div class="hero__btns" data-reveal>
          <a href={site.sponsorUrl} class="btn btn-primary">Sponsor MixHer</a>
          <a href="#djs" class="btn btn-purple">Join the DJ Network</a>
          <a href="#contact" class="btn btn-ghost">Bring MixHer to Your City</a>
        </div>
      </div>
      <div class="hero__art" data-reveal>
        <div class="hero__frame"><Media src="/img/mh-hero.jpg" alt="The MixHer community at a female DJ event" ratio="4 / 3" /></div>
        <Vinyl size={124} className="hero__vinyl" />
        <span class="hero__badge">Est. 2023 · Nationwide</span>
      </div>
    </div>
  </section>

  <!-- PROOF BAR -->
  <section class="proof">
    <div class="wrap proof__grid">
      {proofBar.map((s) => (
        <div class="proof__item" data-reveal><span class="proof__num grad">{s.num}</span><span class="proof__label">{s.label}</span></div>
      ))}
    </div>
  </section>

  <div class="mq-band"><Marquee items={ticker} /></div>

  <!-- WHAT + PILLARS -->
  <section class="section-pad" id="what">
    <div class="wrap narrow" style="text-align:center">
      <p class="spaced center" data-reveal>What is MixHer &amp; why we exist</p>
      <h2 class="fancy" data-reveal>The hub for <span class="grad">what’s next</span> in DJ culture.</h2>
      <p class="lead" data-reveal>Female DJs have the talent, the following, and the vision — they just haven’t always had the stage. MixHer exists to change that.</p>
      <p class="lead" data-reveal>We build the rooms, the network, and the opportunities that get women behind the decks seen, booked, and heard — from the party (<b>PLY</b>) to the industry table (<b>The Set</b>) to the classroom (<b>First Spin DJ Bootcamp</b>). One platform, one mission: put female DJs at the front of the culture.</p>
    </div>
    <div class="wrap" style="margin-top:clamp(2rem,5vw,3.5rem)">
      <div class="grid grid-4">
        {pillars.map((p) => (
          <a href={links(p)} class="card pillar" data-reveal style={`--accent:${p.accent}`} {...(p.key === 'FirstSpin' ? { target: '_blank', rel: 'noopener' } : {})}>
            <h3 class="pillar__t">{p.title}</h3>
            <span class="pillar__s">{p.sub}</span>
            <p class="pillar__b">{p.blurb}</p>
            <span class="pillar__cta">{p.key === 'FirstSpin' ? 'Visit the Bootcamp ↗' : 'Explore →'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FOR DJs + JOIN FORM (gated) -->
  <section class="section-pad tint" id="djs">
    <div class="wrap split">
      <div class="split__media" data-reveal>
        <Media src="/img/mh-djs2.jpg" alt="The MixHer network of female DJs at a rooftop event" ratio="4 / 5" />
      </div>
      <div class="split__text" data-reveal>
        <p class="spaced">For female DJs</p>
        <h2 class="fancy">Built for the DJs <span class="grad">Setting The Tone.</span></h2>
        <p>Join a national network for more stages, stronger industry connections, gig-sharing, resources, brand opportunities, and a community that moves together.</p>
        <p class="gate"><b>By request only.</b> We review every applicant to keep the community — and our private group — real. Approved DJs get the invite by email. No one is auto-added.</p>
        <a href="#contact" class="btn btn-primary djs__cta">Request to join &rarr;</a>
      </div>
    </div>
  </section>

  <!-- FOR BRANDS -->
  <section class="section-pad band-purple">
    <div class="watercolor" aria-hidden="true"></div>
    <div class="wrap band-inner" style="text-align:center">
      <p class="spaced center" data-reveal>For brands &amp; sponsors</p>
      <h2 class="fancy" data-reveal>Put your brand where culture is heard first.</h2>
      <p class="band-lead" data-reveal>Curated events, DJ collaborations, gifting moments, social content, live activations, and nonprofit-aligned visibility — in front of a music-forward audience.</p>
      <div class="band-btns" data-reveal>
        <a href={site.sponsorKitUrl} class="btn btn-primary">Request the Sponsor Kit</a>
        <a href={site.sponsorUrl} class="btn btn-ghost band-glass-btn">See sponsorship</a>
      </div>
    </div>
  </section>

  <!-- EVENTS (PLY + The Set live here) -->
  <section class="section-pad" id="events">
    <div class="wrap">
      <div class="sec-head center"><p class="spaced" data-reveal>The experiences</p>
      <h2 class="display" data-reveal>PLY &amp; The Set</h2>
      <p class="sec-sub" data-reveal><b>PLY</b> is the party — female DJs headlining packed, culture-forward nights where the crowd, artists, and brands all show up. <b>The Set</b> is the industry table — intimate rooms where DJs meet the executives, brands, and venues who book them. Talent gets you noticed at PLY; access gets you booked at The Set. And you never know who’ll pull up — our events regularly draw celebrity guests.</p></div>
      <div class="ev-grid">
        {events.map((e) => (
          <article class="card evc" data-reveal>
            <div class="evc__art"><Media src={e.img} alt={`${e.name} PLY party flyer — female DJs in ${e.city}`} ratio="3 / 4" /></div>
            <div class="evc__body">
              <span class="evc__series">{e.seriesLabel}</span>
              <h3 class="evc__name">{e.name}</h3>
              <p class="evc__meta">{e.date} · {e.time}<br />{e.venue} · {e.city}</p>
              <p class="evc__djs">{e.djs}</p>
              <a href={e.href} class="btn btn-primary">Get tickets</a>
            </div>
          </article>
        ))}

        <article class="card evc" data-reveal>
          <div class="evc__ph evc__ph--set">
            <span class="evc__phkicker">The Set · Networking</span>
            <span class="evc__phbig">Atlanta<br />Aug 9</span>
            <span class="evc__phnote">During Invest Fest</span>
          </div>
          <div class="evc__body">
            <span class="evc__series">The Set · Networking Series</span>
            <h3 class="evc__name">The Set</h3>
            <p class="evc__meta">Sat · Aug 9 · Atlanta, GA<br />During Invest Fest</p>
            <p class="evc__djs">DJs · execs · brands · venues · tastemakers</p>
            <a href="#contact" class="btn btn-ghost">Request an invite</a>
          </div>
        </article>

        <article class="card evc" data-reveal>
          <div class="evc__ph evc__ph--city">
            <span class="evc__phbig evc__phbig--city">Bring MixHer to your city</span>
          </div>
          <div class="evc__body">
            <span class="evc__series">Host · Partner</span>
            <h3 class="evc__name">Your City</h3>
            <p class="evc__meta">Want PLY or The Set where you are? Let’s make it happen — venues, promoters, and partners welcome.</p>
            <a href="#contact" class="btn btn-primary">Bring MixHer to Your City</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- RECAPS (see us in action) -->
  <section class="section-pad tint" id="recaps">
    <div class="wrap">
      <div class="sec-head center"><p class="spaced" data-reveal>Event recaps</p>
      <h2 class="display" data-reveal>See us in action</h2>
      <p class="sec-sub" data-reveal>Rooftops, brunches, and packed nights across the country — press play.</p></div>
      <div class="recap-grid">
        {recaps.map((r) => (
          <figure class="recap" data-reveal>
            <video class="recap__v" src={r.src} poster={r.poster} controls preload="none" playsinline muted></video>
            <figcaption class="recap__cap">
              <span class="recap__title">{r.title}</span>
              <span class="recap__meta">{r.meta}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY marquee -->
  <section class="gallery-sec">
    <div class="wrap"><p class="spaced center" data-reveal style="display:block;text-align:center;margin-bottom:1.4rem">Women behind the decks</p></div>
    <div class="gmq" aria-hidden="true">
      <div class="gmq__track">
        {[...galleryImgs, ...galleryImgs].map((src) => (
          <img class="gmq__img" src={src} alt="A MixHer female DJ event in action" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <!-- AS SEEN AT (Chauvet welcomes MixHer) -->
  <section class="section-pad seenat">
    <div class="wrap">
      <div class="seenat__card" data-reveal>
        <div class="seenat__media"><Media src="/img/mh-theset.jpg" alt="Chauvet DJ welcomes The MixHer on the venue LED wall" ratio="16 / 9" /></div>
        <div class="seenat__text">
          <p class="spaced">Industry-recognized</p>
          <h2 class="fancy">Welcomed by the <span class="grad">industry.</span></h2>
          <p>From Chauvet DJ to Serato, DJ City, and BASSBOSS — the brands that power the culture show up for MixHer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FIRST SPIN (external) -->
  <section class="section-pad tint">
    <div class="wrap split">
      <div class="split__media" data-reveal><Media src="/img/firstspin-student.jpg" alt="A First Spin DJ Bootcamp student learning to DJ" ratio="4 / 3" /></div>
      <div class="split__text" data-reveal>
        <img src="/img/firstspin-logo.png" alt="First Spin DJ Bootcamp logo" class="fs-logo" width="200" height="110" loading="lazy" />
        <h2 class="fancy">Every set fuels the next <span class="grad">first spin.</span></h2>
        <p>First Spin DJ Bootcamp gives youth in underserved communities no-cost DJ education, mentorship, and entrepreneurship exposure — funded by MixHer events.</p>
        <p><b>Why it matters:</b> the next generation of women behind the decks needs a first chance, and most never get near the equipment. First Spin DJ Bootcamp is that chance — and every ticket, sponsorship, and donation helps fund it.</p>
        <div class="fs-btns">
          <a href={site.donateUrl} target="_blank" rel="noopener" class="btn btn-primary">Donate</a>
          <a href={site.firstSpinUrl} target="_blank" rel="noopener" class="btn btn-ghost">Visit First Spin DJ Bootcamp ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SHOP / MERCH -->
  <section class="section-pad tint" id="shop">
    <div class="wrap">
      <div class="sec-head center">
        <p class="spaced" data-reveal>Shop MixHer</p>
        <h2 class="display" data-reveal>Wear the <span class="grad">movement.</span></h2>
        <p class="sec-sub" data-reveal>{merchNote}</p>
      </div>
      <div class="shop-grid">
        {merch.map((m) => (
          <article class="card shopc" data-reveal>
            <div class="shopc__art"><Media src={m.img} alt={`MixHer ${m.color} DGAF tee`} ratio="1 / 1" /></div>
            <div class="shopc__body">
              <div class="shopc__top">
                <h3 class="shopc__name">{m.name}</h3>
                <span class="shopc__price">{m.price}</span>
              </div>
              <span class="shopc__color">{m.color} · Sizes {m.sizes}</span>
              <p class="shopc__blurb">{m.blurb}</p>
              {m.buyUrl
                ? <a href={m.buyUrl} target="_blank" rel="noopener" class="btn btn-primary shopc__btn">Buy now — {m.price}</a>
                : <a href={orderHref(m)} class="btn btn-primary shopc__btn">Order now</a>}
            </div>
          </article>
        ))}
      </div>
      <p class="shop-foot" data-reveal>Sizes S–XXL · Ships nationwide · Questions? <a href={site.emailHref}>{site.email}</a></p>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section-pad">
    <div class="wrap split reverse">
      <div class="split__text" data-reveal>
        <p class="spaced">The founder</p>
        <h2 class="fancy">Founded by <span class="grad">DJ ReRe.</span></h2>
        {founder.bio.map((p) => <p>{p}</p>)}
      </div>
      <div class="split__media" data-reveal><Media src="/img/djrere.jpg" alt="DJ ReRe, founder of MixHer" ratio="4 / 5" /></div>
    </div>
  </section>

  <!-- SPONSOR LOGOS -->
  <section class="section-pad logos">
    <div class="wrap">
      <p class="spaced center" data-reveal>Trusted by brands &amp; partners</p>
      <div class="logos__row" data-reveal>
        {sponsors.map((s) => (
          s.img ? <img class="logos__img" src={s.img} alt={`${s.name} — MixHer sponsor`} loading="lazy" /> : <span class="logos__word">{s.name}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-pad tint" id="contact">
    <div class="wrap">
      <div class="sec-head center">
        <p class="spaced" data-reveal>Contact</p>
        <h2 class="fancy" data-reveal>Let’s <span class="grad">connect.</span></h2>
        <p class="contact__intro" data-reveal>DJ, brand, venue, press, or want to bring MixHer to your city? Tell us who you are — we’ll route it to the right person.</p>
      </div>
      <div class="contact">
        <div class="card contact__form" data-reveal>
          <Form
            formName="Contact the team"
            submit="Send message"
            note={`Or email us directly at ${site.email}`}
            fields={[
              { name: 'reason', label: 'I am a…', type: 'select', required: true, options: ['DJ', 'Brand / sponsor', 'Venue', 'Artist', 'Press / media', 'Donor', 'Bringing MixHer to my city', 'Other'] },
              { name: 'name', label: 'Name', required: true },
              { name: 'email', label: 'Email', type: 'email', required: true },
              { name: 'phone', label: 'Phone', type: 'tel' },
              { name: 'city', label: 'City' },
              { name: 'message', label: 'Message', type: 'textarea', required: true, full: true },
            ]}
          />
        </div>
        <aside class="contact__side" data-reveal>
          <div class="cs__glow" aria-hidden="true"></div>
          <div class="cs__body">
            <h3 class="cs__h">Reach us</h3>
            <a href={site.emailHref} class="cs__email">{site.email}</a>
            <p class="cs__loc">Miami Beach, FL · Events nationwide</p>
            <Social light />
            <hr class="cs__rule" />
            <p class="cs__nltitle">Join the newsletter</p>
            <form class="nl" data-newsletter data-gf={site.googleForm.action} data-gf-email={site.googleForm.entries.email} data-gf-type={site.googleForm.entries.type}>
              <input type="email" name="email" required placeholder="your@email.com" aria-label="Email" />
              <button class="btn btn-primary" type="submit">Join</button>
            </form>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script>
    const nl = document.querySelector('[data-newsletter]') as HTMLFormElement | null;
    nl?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (nl.querySelector('input') as HTMLInputElement)?.value || '';
      const gf = nl.dataset.gf;
      if (gf) {
        const out = new FormData();
        if (nl.dataset.gfEmail) out.append(nl.dataset.gfEmail, email);
        if (nl.dataset.gfType) out.append(nl.dataset.gfType, 'Newsletter');
        fetch(gf, { method: 'POST', mode: 'no-cors', body: out }).catch(() => {});
      } else {
        window.location.href = `mailto:info@themixher.org?subject=${encodeURIComponent('[MixHer] Newsletter signup')}&body=${encodeURIComponent('Please add me: ' + email)}`;
      }
      nl.innerHTML = '<p style="margin:0;color:var(--orchid-deep);font-family:var(--sans);font-weight:800;">YOU’RE IN ✦</p>';
    });
  </script>
</Base>

<style>
  .wc { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(40vw 40vw at 80% 18%, rgba(203,108,230,0.22), transparent 60%),
      radial-gradient(30vw 30vw at 94% 60%, rgba(254,154,0,0.18), transparent 60%),
      radial-gradient(28vw 28vw at 64% 2%, rgba(228,168,243,0.22), transparent 62%); }

  .hero { position: relative; padding-block: clamp(2rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
  .hero__h { font-size: clamp(2.3rem, 5.2vw, 4.4rem); margin: 0.4rem 0 0; }
  .hero__script { font-family: var(--script); font-size: clamp(1.8rem, 4vw, 2.8rem); color: var(--orchid-deep); line-height: 0.8; margin: 0.3rem 0 0.6rem; }
  .hero__sub { color: var(--muted); max-width: 48ch; font-size: 1.05rem; }
  .hero__btns { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .hero__art { position: relative; }
  .hero__frame { position: relative; }
  .hero__frame::before { content: ''; position: absolute; inset: -12px -12px 12px 12px; border-radius: var(--radius-lg); border: 2px dashed var(--lavender); pointer-events: none; z-index: -1; }
  .hero__vinyl { position: absolute; bottom: -34px; left: -34px; z-index: 2; }
  .hero__badge { position: absolute; top: -14px; right: 8%; background: var(--ink); color: #fff; font-family: var(--display); font-weight: 800; font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.5rem 1rem; border-radius: 999px; }
  @media (max-width: 860px) { .hero__grid { grid-template-columns: 1fr; } .hero__art { max-width: 480px; margin: 1.5rem auto 0; } }

  .gallery-sec { padding-block: clamp(2rem, 5vw, 3.5rem); overflow: hidden; }
  .gmq { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .gmq__track { display: flex; gap: 1rem; width: max-content; animation: gscroll 48s linear infinite; }
  .gmq:hover .gmq__track { animation-play-state: paused; }
  @keyframes gscroll { to { transform: translateX(-50%); } }
  .gmq__img { height: 240px; width: auto; border-radius: var(--radius); object-fit: cover; box-shadow: var(--shadow); }
  @media (prefers-reduced-motion: reduce) { .gmq__track { animation: none; } }
  @media (max-width: 620px) { .gmq__img { height: 170px; } }

  .recap-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1rem, 2.5vw, 1.6rem); }
  @media (max-width: 620px) { .recap-grid { grid-template-columns: 1fr; } }
  .recap { margin: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); background: #000; }
  .recap__v { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #000; }
  .recap__cap { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; padding: 0.85rem 1.1rem; background: #fff; }
  .recap__title { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 0.95rem; }
  .recap__meta { color: var(--muted); font-size: 0.8rem; white-space: nowrap; }

  .seenat__card { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; background: #fff; border: 1px solid var(--card-brd); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .seenat__text { padding: clamp(1.4rem, 4vw, 2.4rem) clamp(1.4rem, 4vw, 2.4rem) clamp(1.4rem, 4vw, 2.4rem) 0; }
  .seenat__text p { color: var(--muted); max-width: 46ch; }
  .seenat__text h2 { margin: 0.3rem 0 0.5rem; }
  @media (max-width: 780px) { .seenat__card { grid-template-columns: 1fr; } .seenat__text { padding: 0 1.4rem 1.6rem; } }

  .proof { border-block: 1px solid var(--card-brd); background: var(--bg-2); }
  .proof__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; padding-block: clamp(1.8rem, 4vw, 2.6rem); text-align: center; }
  .proof__num { font-family: var(--display); font-weight: 800; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1; }
  .proof__label { display: block; color: var(--muted); font-size: 0.76rem; margin-top: 0.4rem; }
  @media (max-width: 820px) { .proof__grid { grid-template-columns: repeat(2, 1fr); gap: 1.4rem; } }

  .mq-band { padding-block: 1.3rem; border-bottom: 1px solid var(--card-brd); background: #fff; }

  .lead { color: var(--muted); font-size: 1.12rem; max-width: 60ch; margin: 1.1rem auto 0; }
  .center { display: block; text-align: center; }
  .sec-head { margin-bottom: clamp(1.8rem, 4vw, 2.6rem); }
  .sec-head.center { text-align: center; }
  .sec-head .spaced { display: inline-block; margin-bottom: 0.7rem; }
