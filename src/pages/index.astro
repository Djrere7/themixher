---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, offerings, featuredDJs, stats, ticker, press } from '../data/site';
---
<Base>
  <!-- ======================= HERO (NeoBeat split) ======================= -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="spaced" data-reveal>The nonprofit platform for female DJs</p>
        <h1 class="display hero__h" data-reveal>Female DJs<br />lead the <span class="grad-o">vibe.</span></h1>
        <p class="hero__script script" data-reveal>All vibes welcome.</p>
        <p class="hero__sub" data-reveal>{site.coreSentence}</p>
        <div class="hero__btns" data-reveal>
          <a href={site.donateUrl} class="btn btn-primary">Donate</a>
          <a href={site.sponsorUrl} class="btn btn-ghost">Become a sponsor</a>
        </div>
      </div>
      <div class="hero__art" data-reveal>
        <div class="hero__disc"><Media label="MixHer" className="circle" ratio="1 / 1" /></div>
        <span class="hero__badge">Est. 2023 · Miami</span>
      </div>
    </div>
  </section>

  <div class="mq-band"><Marquee items={ticker} /></div>

  <!-- ======================= WELCOME / MISSION ======================= -->
  <section class="section-pad">
    <div class="wrap welcome">
      <div class="welcome__text">
        <p class="kicker" data-reveal>Welcome to MixHer</p>
        <h2 class="display" data-reveal>More than a party.<br /><span class="grad">A movement.</span></h2>
        <p data-reveal>
          MixHer spotlights the trailblazers who shatter glass ceilings on turntables — creating a
          platform for their artistry, a network for their growth, and a community that champions their
          success. We start in Miami, and we’re taking it nationwide.
        </p>
        <a href="/about" class="btn btn-ghost" data-reveal>Our story</a>
      </div>
      <div class="welcome__stats" data-reveal>
        {stats.map((s) => (
          <div class="wstat">
            <span class="stat__num grad">{s.num}</span>
            <span class="stat__label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= WHAT WE DO (single block) ======================= -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head">
        <p class="spaced" data-reveal>What we do</p>
        <h2 class="display" data-reveal>Culture-forward experiences</h2>
      </div>
      <div class="grid grid-3">
        {offerings.map((o) => (
          <article class="card offer" data-reveal>
            <span class="offer__tag">{o.tag}</span>
            <h3 class="offer__title">{o.title}</h3>
            <p class="offer__blurb">{o.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= FEATURED DJs (NeoBeat artist grid) ======================= -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head sec-head--row">
        <div>
          <p class="spaced" data-reveal>The talent</p>
          <h2 class="display" data-reveal>Women behind the decks</h2>
        </div>
        <a href="/community" class="btn btn-ghost hide-sm" data-reveal>Join the roster</a>
      </div>
      <div class="grid grid-4 djs">
        {featuredDJs.map((dj) => (
          <a href="/community" class="dj" data-reveal>
            <div class="dj__disc"><Media src={dj.img || undefined} label="DJ" className="circle" ratio="1 / 1" /></div>
            <h3 class="dj__name">{dj.name}</h3>
            <span class="dj__handle">{dj.handle}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= UPCOMING (NeoBeat tour teaser) ======================= -->
  <section class="section-pad tint-lav">
    <div class="wrap upcoming">
      <div class="upcoming__text" data-reveal>
        <p class="spaced">Upcoming</p>
        <h2 class="display">Catch the<br />next one.</h2>
        <p>New MixHer experiences are always in motion. See what’s coming up, or join the community to be first to know.</p>
        <div class="upcoming__btns">
          <a href="/events" class="btn btn-primary">See events</a>
          <a href={site.socials.instagram} target="_blank" rel="noopener" class="btn btn-ghost">Follow @themixher</a>
        </div>
      </div>
      <div class="upcoming__art" data-reveal><Media label="Next event" ratio="4 / 5" /></div>
    </div>
  </section>

  <!-- ======================= PRESS ======================= -->
  <section class="section-pad logos">
    <div class="wrap">
      <p class="spaced center" data-reveal>As seen in</p>
      <div class="logos__row" data-reveal>
        {press.map((name) => <span class="logos__item">{name}</span>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(2rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem); }
  .hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero__h { font-size: clamp(3rem, 10vw, 7rem); margin: 0.5rem 0 0; }
  .hero__script { font-family: var(--script); font-size: clamp(2.6rem, 6.5vw, 5rem); color: var(--orchid-deep); line-height: 0.7; margin: 0.2rem 0 0.9rem; }
  .hero__sub { color: var(--muted); max-width: 46ch; font-size: 0.98rem; }
  .hero__btns { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.6rem; }
  .hero__art { position: relative; }
  .hero__disc { position: relative; animation: spin 40s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hero__disc { animation: none; } }
  .hero__badge { position: absolute; bottom: 8%; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; font-family: var(--display); font-weight: 800; font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.5rem 1rem; border-radius: 999px; white-space: nowrap; }
  @media (max-width: 860px) { .hero__grid { grid-template-columns: 1fr; } .hero__art { max-width: 380px; margin: 0 auto; } }

  .mq-band { padding-block: 1.4rem; border-block: 1px solid var(--card-brd); background: #fff; }

  /* Welcome */
  .welcome { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .welcome__text p { color: var(--muted); max-width: 50ch; }
  .welcome__text .btn { margin-top: 0.6rem; }
  .welcome__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 1rem; }
  .wstat { display: flex; flex-direction: column; gap: 0.2rem; }
  @media (max-width: 820px) { .welcome { grid-template-columns: 1fr; } }

  /* Section heads */
  .sec-head { margin-bottom: clamp(1.8rem, 4vw, 3rem); }
  .sec-head .spaced { display: block; margin-bottom: 0.8rem; }
  .sec-head--row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
  .center { display: block; text-align: center; }

  /* Offerings */
  .offer { display: flex; flex-direction: column; gap: 0.4rem; }
  .offer__tag { font-family: var(--display); font-weight: 800; font-size: 0.9rem; color: var(--orange); letter-spacing: 0.1em; }
  .offer__title { font-family: var(--display); font-weight: 800; font-size: 1.35rem; text-transform: uppercase; letter-spacing: -0.01em; margin: 0; }
  .offer__blurb { color: var(--muted); margin: 0; font-size: 0.92rem; }

  /* Featured DJs */
  .djs { margin-top: 0.5rem; }
  .dj { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.5rem; }
  .dj__disc { width: 100%; transition: transform 0.25s ease; }
  .dj:hover .dj__disc { transform: translateY(-6px); }
  .dj__name { font-family: var(--display); font-weight: 800; font-size: 1.2rem; text-transform: uppercase; margin: 0.3rem 0 0; }
  .dj__handle { color: var(--orchid-deep); font-size: 0.82rem; }

  /* Upcoming */
  .upcoming { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .upcoming__text p { color: var(--muted); max-width: 46ch; }
  .upcoming__btns { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.4rem; }
  @media (max-width: 860px) { .upcoming { grid-template-columns: 1fr; } .upcoming__art { max-width: 420px; } }

  /* Logos */
  .logos__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2.4rem; margin-top: 1.6rem; }
  .logos__item { font-family: var(--display); font-weight: 800; font-size: clamp(1rem, 2.2vw, 1.5rem); text-transform: uppercase; color: var(--dim); transition: color 0.2s ease; }
  .logos__item:hover { color: var(--orchid-deep); }

  @media (max-width: 620px) { .hide-sm { display: none; } }
</style>
