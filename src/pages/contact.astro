---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Form from '../components/Form.astro';
import { site } from '../data/site';
---
<Base
  title="Contact"
  fullTitle="Contact MixHer | Female DJ Nonprofit & Event Series"
  description="Contact the MixHer team — for DJs, brands, sponsors, venues, artists, press, donations, or to bring MixHer to your city."
>
  <PageHeader
    kicker="Contact"
    title={`Let’s <span class='grad'>connect.</span>`}
    lead="Tell us who you are and what you need — we’ll route it to the right person on the MixHer team."
  />

  <section class="section-pad">
    <div class="wrap contact">
      <div class="card formcard" data-reveal>
        <Form
          formName="Contact the team"
          submit="Send message"
          note={`Prefer email? Reach us at ${site.email}.`}
          fields={[
            { name: 'reason', label: 'I am reaching out as…', type: 'select', required: true, options: ['I am a DJ', 'I am a brand/sponsor', 'I am a venue', 'I am an artist', 'I am press/media', 'I want to donate', 'I want to bring MixHer to my city', 'Other'] },
            { name: 'name', label: 'Name', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'city', label: 'City' },
            { name: 'message', label: 'Message', type: 'textarea', required: true, full: true },
          ]}
        />
      </div>

      <aside class="cside" data-reveal>
        <div class="card">
          <h3 class="cside__h">Quick links</h3>
          <div class="cside__btns">
            <a href={site.joinUrl} class="btn btn-primary">Join the DJ Network</a>
            <a href={site.sponsorUrl} class="btn btn-ghost">Sponsor MixHer</a>
            <a href={site.donateUrl} class="btn btn-ghost">Fund First Spin</a>
            <a href={site.bringUrl} class="btn btn-ghost">Bring MixHer to Your City</a>
          </div>
        </div>
        <div class="card">
          <h3 class="cside__h">Reach us</h3>
          <a href={site.emailHref} class="cside__row"><span>Email</span>{site.email}</a>
          <p class="cside__row"><span>Based in</span>Miami Beach, FL · Events nationwide</p>
        </div>
        <div class="card">
          <h3 class="cside__h">Follow</h3>
          <div class="cside__socials">
            <a href={site.socials.instagram} target="_blank" rel="noopener">Instagram</a>
            <a href={site.socials.tiktok} target="_blank" rel="noopener">TikTok</a>
            <a href={site.socials.youtube} target="_blank" rel="noopener">YouTube</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    // Prefill the reason dropdown from ?reason=
    const p = new URLSearchParams(location.search).get('reason');
    if (p) {
      const map = { 'bring-mixher': 'I want to bring MixHer to my city', mentor: 'I am a DJ', grant: 'I want to donate' };
      const sel = document.getElementById('f-reason');
      if (sel && map[p]) sel.value = map[p];
    }
  </script>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  .formcard { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .cside { display: flex; flex-direction: column; gap: 1rem; }
  .cside__h { font-family: var(--display); font-weight: 800; font-size: 1.15rem; text-transform: uppercase; margin: 0 0 0.8rem; }
  .cside__btns { display: flex; flex-direction: column; gap: 0.6rem; }
  .cside__btns .btn { width: 100%; }
  .cside__row { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.5rem 0; border-top: 1px solid var(--card-brd); color: var(--ink); }
  .cside__row span { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .cside__socials { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cside__socials a { font-size: 0.85rem; padding: 0.4rem 0.9rem; border: 1px solid var(--card-brd); border-radius: 999px; color: var(--muted); transition: color 0.2s, border-color 0.2s; }
  .cside__socials a:hover { color: var(--ink); border-color: var(--orchid); }
</style>
