---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';

const reasons = ['Sponsor / brand partnership', 'Book MixHer / venue programming', 'Perform as a DJ', 'First Spin / education', 'Press & media', 'General'];
---
<Base title="Contact" description="Contact The MixHer — sponsor, book, perform, donate, or partner. Reach the team by email or phone, or send a message.">
  <PageHeader
    kicker="Contact"
    title={`Let’s <span class='grad'>connect.</span>`}
    lead="Sponsor, book, perform, or partner — tell us what you have in mind and the MixHer team will get right back to you."
  />

  <section class="section-pad">
    <div class="wrap contact">
      <!-- Form -->
      <form class="card cform" action={site.emailHref} method="post" enctype="text/plain" data-reveal>
        <div class="cfield">
          <label for="name">Name</label>
          <input id="name" name="name" required placeholder="Your name" />
        </div>
        <div class="cfield">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required placeholder="you@email.com" />
        </div>
        <div class="cfield">
          <label for="reason">I’m reaching out about</label>
          <select id="reason" name="reason">
            {reasons.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>
        <div class="cfield">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell us a little about what you have in mind…"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
        <p class="cform__note">Prefer email? Reach us directly at <a href={site.emailHref} class="ilink">{site.email}</a>.</p>
      </form>

      <!-- Direct info + quick actions -->
      <aside class="cside" data-reveal>
        <div class="card">
          <h3 class="cside__h">Reach us</h3>
          <a href={site.emailHref} class="cside__row"><span>Email</span>{site.email}</a>
          <a href={site.phoneHref} class="cside__row"><span>Phone / text</span>{site.phone}</a>
          <p class="cside__row"><span>Based in</span>{site.city}</p>
        </div>

        <div class="card">
          <h3 class="cside__h">Take action</h3>
          <div class="cside__btns">
            <a href={site.donateUrl} class="btn btn-yellow">Donate</a>
            <a href={site.sponsorUrl} class="btn btn-ghost">Sponsor</a>
            <a href={site.whatsappUrl} class="btn btn-ghost">Join community</a>
            <a href={site.applyUrl} class="btn btn-ghost">Apply to perform</a>
          </div>
        </div>

        <div class="card">
          <h3 class="cside__h">Follow</h3>
          <div class="cside__socials">
            <a href={site.socials.instagram} target="_blank" rel="noopener">Instagram</a>
            <a href={site.socials.tiktok} target="_blank" rel="noopener">TikTok</a>
            <a href={site.socials.youtube} target="_blank" rel="noopener">YouTube</a>
            <a href={site.socials.facebook} target="_blank" rel="noopener">Facebook</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }

  .cform { display: flex; flex-direction: column; gap: 1rem; }
  .cfield { display: flex; flex-direction: column; gap: 0.4rem; }
  .cfield label { font-family: var(--display); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.9rem; color: var(--lavender); }
  .cform input, .cform select, .cform textarea {
    width: 100%; padding: 0.85rem 1rem; border-radius: 12px;
    background: rgba(0,0,0,0.35); border: 1px solid var(--card-brd); color: var(--ink);
    font-family: var(--body); font-size: 0.95rem; resize: vertical;
  }
  .cform input:focus, .cform select:focus, .cform textarea:focus { outline: none; border-color: var(--card-brd-hi); }
  .cform .btn { align-self: flex-start; margin-top: 0.4rem; }
  .cform__note { color: var(--dim); font-size: 0.85rem; margin: 0; }
  .ilink { color: var(--pink-hot); }

  .cside { display: flex; flex-direction: column; gap: 1rem; }
  .cside__h { font-family: var(--display); font-size: 1.4rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 0.8rem; color: var(--ink); }
  .cside__row { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.5rem 0; border-top: 1px solid rgba(255,255,255,0.05); color: var(--ink); }
  .cside__row span { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .cside__btns { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .cside__btns .btn { width: 100%; font-size: 0.9rem; padding: 0.6rem 1rem 0.5rem; }
  .cside__socials { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cside__socials a { font-size: 0.85rem; padding: 0.4rem 0.9rem; border: 1px solid var(--card-brd); border-radius: 999px; color: var(--muted); transition: color 0.2s, border-color 0.2s; }
  .cside__socials a:hover { color: var(--ink); border-color: var(--card-brd-hi); }
</style>
