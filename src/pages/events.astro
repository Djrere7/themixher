---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

// Events — wire real dates/Eventbrite links here as they're confirmed.
const upcoming: { title: string; date: string; venue: string; blurb: string; href: string }[] = [];

const formats = [
  { title: 'Live DJ Showcases', blurb: 'Curated female DJ sets on real stages — the spotlight women behind the decks deserve.' },
  { title: 'Networking Mixers', blurb: 'Rooms full of DJs, promoters, media, venues, and label execs — where careers get made.' },
  { title: 'Brunch & Beats', blurb: 'Daytime experiences with food, drinks, and all-female lineups in Miami’s best rooms.' },
  { title: 'Brand Activations', blurb: 'Sponsor-powered moments — giveaways, photo experiences, and content built into the night.' },
];
---
<Base title="Events" description="MixHer events — live female DJ showcases, networking mixers, and brand activations across Miami and beyond. See what’s coming up.">
  <PageHeader
    kicker="Events"
    title={`Where the movement<br/><span class='grad'>comes alive.</span>`}
    lead="From our Art Basel debut to monthly mixers and rooftop showcases, MixHer events are high-vibe rooms where female DJs perform and the industry connects."
  />

  <!-- Upcoming -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head"><p class="kicker" data-reveal>Upcoming</p>
      <h2 class="display" data-reveal>Next up</h2></div>

      {upcoming.length > 0 ? (
        <div class="grid grid-2">
          {upcoming.map((e) => (
            <article class="card ev" data-reveal>
              <span class="ev__date">{e.date}</span>
              <h3 class="ev__title">{e.title}</h3>
              <p class="ev__venue">{e.venue}</p>
              <p class="ev__blurb">{e.blurb}</p>
              <a href={e.href} class="btn btn-primary">Get tickets</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="card empty" data-reveal>
          <h3 class="empty__h">New dates dropping soon ✦</h3>
          <p>The next MixHer experiences are being locked in. Join the community or our newsletter to be first to know — and follow <a href={site.socials.instagram} target="_blank" rel="noopener" class="ilink">@themixher</a> for announcements.</p>
          <div class="empty__btns">
            <a href="/community" class="btn btn-primary">Join the community</a>
            <a href={site.socials.instagram} target="_blank" rel="noopener" class="btn btn-ghost">Follow on Instagram</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Event formats -->
  <section class="section-pad formats">
    <div class="wrap">
      <div class="sec-head"><p class="kicker" data-reveal>What to expect</p>
      <h2 class="display" data-reveal>Our event formats</h2></div>
      <div class="grid grid-4">
        {formats.map((f) => (
          <div class="card fmt" data-reveal>
            <h3 class="fmt__title">{f.title}</h3>
            <p class="fmt__blurb">{f.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Signature moment / history -->
  <section class="section-pad">
    <div class="wrap sig">
      <div class="sig__text" data-reveal>
        <p class="kicker">A signature debut</p>
        <h2 class="display">Setting the Tone, <span class="grad">2023</span></h2>
        <p>
          MixHer debuted during Art Basel / Miami Art Week with a public DJ brunch — 25+ female DJs and
          radio personalities, hundreds in attendance, and an exclusive listening experience with
          Grammy-winning singer Maxine Ashley. On-site Q&amp;As with label executives, an unreleased music
          premiere, and a room full of connection made in real time.
        </p>
        <p>It set the standard for every MixHer experience since: real stages, real industry, real community.</p>
      </div>
      <div class="sig__media" data-reveal>
        <Media label="Setting the Tone 2023" ratio="4 / 3" />
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head"><p class="kicker" data-reveal>From the floor</p>
      <h2 class="display" data-reveal>The energy</h2></div>
      <div class="gallery">
        {Array.from({ length: 6 }).map((_, i) => (
          <Media label={`Event photo ${i + 1}`} ratio="1 / 1" className="gallery__item" />
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Want your brand at the next one?"
    primaryLabel="Become a sponsor"
    primaryHref="/sponsors"
    secondaryLabel="Perform with us"
    secondaryHref={site.applyUrl}
  />
</Base>

<style>
  .ev { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  .ev__date { font-family: var(--display); letter-spacing: 0.14em; color: var(--pink-hot); }
  .ev__title { font-family: var(--display); font-size: 2rem; letter-spacing: 0.03em; text-transform: uppercase; margin: 0; }
  .ev__venue { color: var(--lavender); margin: 0; }
  .ev__blurb { color: var(--muted); margin: 0.3rem 0 1rem; }

  .empty { text-align: center; }
  .empty__h { font-family: var(--display); font-size: 2rem; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 0.6rem; }
  .empty p { color: var(--muted); max-width: 54ch; margin: 0 auto 1.4rem; }
  .empty__btns { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
  .ilink { color: var(--pink-hot); }

  .formats { border-block: 1px solid var(--card-brd); background: linear-gradient(180deg, rgba(117,56,234,0.05), transparent); }
  .fmt { display: flex; flex-direction: column; gap: 0.4rem; }
  .fmt__title { font-family: var(--display); font-size: 1.4rem; letter-spacing: 0.03em; text-transform: uppercase; margin: 0; color: var(--lavender); }
  .fmt__blurb { color: var(--muted); margin: 0; font-size: 0.9rem; }

  .sig { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .sig__text p { color: var(--muted); max-width: 54ch; }
  @media (max-width: 840px) { .sig { grid-template-columns: 1fr; } .sig__media { order: -1; } }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.6rem, 1.5vw, 1rem); }
  @media (max-width: 620px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
</style>
