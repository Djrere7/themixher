---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
---
<Base title="First Spin — Youth DJ Education" description="First Spin is The MixHer's youth DJ education initiative — developing the next generation of female DJs through education, mentorship, creativity, and access.">
  <PageHeader
    kicker="First Spin · Youth DJ Education"
    title={`Every legend had a<br/><span class='grad'>first spin.</span>`}
    lead="First Spin is MixHer’s youth DJ education initiative — developing the next generation of female DJs through education, mentorship, creativity, and access."
    serif={true}
  />

  <!-- Intro -->
  <section class="section-pad">
    <div class="wrap fs">
      <div class="fs__media" data-reveal><Media label="First Spin class" ratio="4 / 3" /></div>
      <div class="fs__text" data-reveal>
        <p class="kicker">The mission</p>
        <h2 class="fancy">Access, not <span class="grad">barriers.</span></h2>
        <p>
          The biggest thing between a young girl and the decks is access — to equipment, to instruction,
          and to someone who looks like her doing it. First Spin removes those barriers with free classes
          and real gear, so talent, not budget, decides who gets to play.
        </p>
        <p>We teach the fundamentals of DJing to the next generation — the foundation every future headliner starts from.</p>
      </div>
    </div>
  </section>

  <!-- What they learn -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head"><p class="kicker" data-reveal>What students learn</p>
      <h2 class="display" data-reveal>From zero to first mix</h2></div>
      <div class="grid grid-3">
        <div class="card" data-reveal><h3 class="learn__h">The Gear</h3><p class="learn__p">Controllers, decks, and mixers — what each does and how to set up with confidence.</p></div>
        <div class="card" data-reveal><h3 class="learn__h">Beatmatching</h3><p class="learn__p">Reading music, counting bars, and blending two tracks into one seamless groove.</p></div>
        <div class="card" data-reveal><h3 class="learn__h">Reading a Room</h3><p class="learn__p">Song selection, energy, and the art of keeping a crowd moving.</p></div>
        <div class="card" data-reveal><h3 class="learn__h">Confidence</h3><p class="learn__p">Stage presence and self-belief — playing like the room is already yours.</p></div>
        <div class="card" data-reveal><h3 class="learn__h">Your First Set</h3><p class="learn__p">Every student builds and performs a real mix by the end of the program.</p></div>
        <div class="card" data-reveal><h3 class="learn__h">Community</h3><p class="learn__p">A graduation into the wider MixHer network of mentors and peers.</p></div>
      </div>
    </div>
  </section>

  <!-- Enroll + Fund -->
  <section class="section-pad">
    <div class="wrap">
      <div class="grid grid-2">
        <div class="card fscta" data-reveal>
          <h3 class="fscta__h grad">Enroll a student</h3>
          <p>Know a young girl who wants to learn? Reach out and we’ll share upcoming class dates and how to sign up — always free.</p>
          <a href={site.emailHref} class="btn btn-purple">Ask about classes</a>
        </div>
        <div class="card fscta" data-reveal>
          <h3 class="fscta__h grad-o">Fund a future DJ</h3>
          <p>Your gift buys equipment and funds free instruction for a girl who couldn’t otherwise start. {site.taxLine}</p>
          <a href={site.donateUrl} class="btn btn-primary">Donate to First Spin</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Help fund the next first spin."
    sub="Every donation and sponsorship puts gear in a girl’s hands and headphones on her ears."
    primaryLabel="Donate"
    primaryHref={site.donateUrl}
    secondaryLabel="Sponsor a class"
    secondaryHref="/sponsors"
  />
</Base>

<style>
  .fs { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .fs__text p { color: var(--muted); max-width: 52ch; }
  @media (max-width: 840px) { .fs { grid-template-columns: 1fr; } }

  .sec-head .kicker { margin-bottom: 0.7rem; }
  .learn__h { font-family: var(--sans); font-weight: 800; font-size: 1.4rem; text-transform: uppercase; margin: 0 0 0.4rem; color: var(--orchid-deep); }
  .learn__p { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .fscta { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .fscta__h { font-family: var(--sans); font-weight: 800; font-size: 1.9rem; text-transform: uppercase; margin: 0; }
  .fscta p { color: var(--muted); margin: 0 0 0.6rem; }
</style>
