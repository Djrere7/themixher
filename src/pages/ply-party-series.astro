---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, events } from '../data/site';
const gallery = ['/img/dj-flowers.jpg', '/img/fan.jpg', '/img/laugh.jpg', '/img/group2.jpg', '/img/toast.jpg', '/img/crowd.jpg'];
const who = ['Female DJs', 'Music lovers', 'Brands', 'Artists', 'Creatives', 'Tastemakers'];
---
<Base
  title="PLY Party Series"
  fullTitle="PLY Party Series | Female DJ Events by MixHer"
  description="PLY is MixHer’s high-energy female DJ party series — packed rooms, culture-forward music, brand activations, and content-ready nightlife across the country."
>
  <PageHeader
    kicker="PLY · The Party Series"
    title={`Press <span class='grad-o'>PLY.</span>`}
    lead="PLY is MixHer’s high-energy party series built around female DJs, packed rooms, culture-forward music, surprise moments, brand activations, and content-ready nightlife experiences."
    serif={true}
  />

  <!-- What / who -->
  <section class="section-pad">
    <div class="wrap split">
      <div class="split__media" data-reveal><Media src="/img/event-ply.jpg" alt="MixHer PLY party series flyer with an all-female DJ lineup" ratio="4 / 5" /></div>
      <div class="split__text" data-reveal>
        <p class="spaced c-orange">What PLY is</p>
        <h2 class="fancy">The night female DJs <span class="grad-o">run.</span></h2>
        <p>PLY is where the crowd, DJs, artists, brands, and culture come together. Every PLY is defined by the experience — nightlife-driven, music-forward, highly visual, and built to be felt.</p>
        <p class="who-label">Who’s in the room</p>
        <div class="chips">{who.map((w) => <span class="chip on">{w}</span>)}</div>
        <a href="/events" class="btn btn-primary" style="margin-top:1.2rem">Attend PLY</a>
      </div>
    </div>
  </section>

  <!-- Why brands/venues -->
  <section class="section-pad band-purple">
    <div class="watercolor" aria-hidden="true"></div>
    <div class="wrap band-inner">
      <div class="sec-head center"><p class="spaced" data-reveal>Why brands &amp; venues want PLY</p>
      <h2 class="fancy" data-reveal>Energy, audience &amp; content — guaranteed.</h2></div>
      <div class="grid grid-3">
        <div class="card band-glass gcard" data-reveal><h3>For brands</h3><p>Live activations, DJ collaborations, and gifting moments in front of a music-forward crowd.</p></div>
        <div class="card band-glass gcard" data-reveal><h3>For venues</h3><p>A packed, press-worthy night with programming, audience, and content built in.</p></div>
        <div class="card band-glass gcard" data-reveal><h3>For culture</h3><p>Female DJs on the main stage, setting the tone for what’s next.</p></div>
      </div>
      <div class="center" style="margin-top:2rem"><a href={site.sponsorKitUrl} class="btn btn-primary">Sponsor PLY</a></div>
    </div>
  </section>

  <!-- Events -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head"><p class="spaced" data-reveal>Upcoming</p><h2 class="display" data-reveal>Next PLY</h2></div>
      {events.filter((e) => e.series === 'PLY').map((e) => (
        <article class="ev card" data-reveal>
          <div class="ev__art"><Media src={e.img} alt={`${e.name} PLY flyer`} ratio="2 / 3" /></div>
          <div class="ev__body">
            <span class="ev__series">{e.seriesLabel}</span>
            <h3 class="ev__name">{e.name}</h3>
            <p class="ev__blurb">{e.blurb}</p>
            <ul class="ev__meta"><li><b>When</b>{e.date} · {e.time}</li><li><b>Where</b>{e.venue} · {e.city}</li><li><b>Lineup</b>{e.djs}</li></ul>
            <a href={e.href} class="btn btn-primary">Get tickets</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Gallery -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head"><p class="spaced" data-reveal>The vibe</p><h2 class="display" data-reveal>From the floor</h2></div>
      <div class="gallery">{gallery.map((src) => <Media src={src} alt="MixHer PLY party series crowd and female DJs" ratio="1 / 1" />)}</div>
    </div>
  </section>

  <CtaBand heading="Bring PLY to your city." primaryLabel="Sponsor MixHer" primaryHref={site.sponsorUrl} secondaryLabel="Bring MixHer to Your City" secondaryHref={site.bringUrl} />
</Base>

<style>
  .sec-head .spaced { display: inline-block; margin-bottom: 0.7rem; }
  .sec-head.center { text-align: center; }
  .center { text-align: center; }
  .split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split__text p { color: var(--muted); max-width: 52ch; }
  .who-label { font-family: var(--display); font-weight: 800; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin: 1.2rem 0 0.6rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 840px) { .split { grid-template-columns: 1fr; } .split__media { order: -1; max-width: 380px; } }

  .band-inner { position: relative; z-index: 1; }
  .gcard h3 { font-family: var(--display); font-weight: 800; font-size: 1.4rem; text-transform: uppercase; margin: 0 0 0.4rem; color: #fff; }
  .gcard p { color: rgba(255,255,255,0.9); margin: 0; }

  .ev { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .ev__art { border-radius: var(--radius); overflow: hidden; max-width: 300px; }
  .ev__series { font-family: var(--display); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange); }
  .ev__name { font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 5vw, 3rem); text-transform: uppercase; margin: 0.2rem 0 0.5rem; }
  .ev__blurb { color: var(--muted); margin: 0 0 1rem; max-width: 48ch; }
  .ev__meta { list-style: none; margin: 0 0 1.2rem; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .ev__meta li { color: var(--ink); font-size: 0.95rem; }
  .ev__meta b { font-family: var(--display); font-weight: 800; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orchid-deep); margin-right: 0.6rem; }
  @media (max-width: 720px) { .ev { grid-template-columns: 1fr; } .ev__art { max-width: 240px; } }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.6rem, 1.5vw, 1rem); }
  @media (max-width: 620px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
</style>
