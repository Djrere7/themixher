---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, founder, proofBar } from '../data/site';
---
<Base
  title="About"
  fullTitle="About MixHer | National Female DJ Nonprofit Founded in Miami"
  description="MixHer is a national 501(c)(3) nonprofit event series and DJ network founded in Miami by DJ ReRe — building stages, industry access, and community for female DJs."
>
  <PageHeader
    kicker="About MixHer"
    title={`Setting the tone for<br/>female DJs <span class='grad'>nationwide.</span>`}
    lead="MixHer is a national 501(c)(3) nonprofit event series and DJ network — more than a party, a cultural shift where women lead, headline, and shine."
  />

  <!-- Mission -->
  <section class="section-pad">
    <div class="wrap narrow" style="text-align:center">
      <p class="spaced center" data-reveal>Our mission</p>
      <h2 class="fancy" data-reveal>Why MixHer exists.</h2>
      <p class="mission" data-reveal>{site.mission}</p>
    </div>
  </section>

  <!-- Story -->
  <section class="section-pad tint">
    <div class="wrap split">
      <div class="split__media" data-reveal><Media src="/img/dj-flowers.jpg" alt="Female DJ performing behind the decks at a MixHer event" ratio="4 / 5" /></div>
      <div class="split__text" data-reveal>
        <p class="spaced">The story</p>
        <h2 class="fancy">Built for the culture, <span class="grad">by the culture.</span></h2>
        <p>MixHer produces culture-forward events through PLY, creates industry networking through The Set, builds a national community through the DJ Network, and funds youth education through First Spin DJ Bootcamp.</p>
        <p>Founded in Miami and built nationwide, MixHer is the go-to platform for female DJs, brands, venues, artists, and music lovers who want to be part of what is next in DJ culture.</p>
        <p class="story__line">{site.vibeline}</p>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="section-pad">
    <div class="wrap">
      <div class="grid grid-4 statgrid">
        {proofBar.slice(0, 4).map((s) => (
          <div class="statcard" data-reveal><span class="statcard__n grad">{s.num}</span><span class="statcard__l">{s.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section-pad tint">
    <div class="wrap split reverse">
      <div class="split__text" data-reveal>
        <p class="spaced">The founder</p>
        <h2 class="fancy">Founded by <span class="grad">DJ ReRe.</span></h2>
        {founder.bio.map((p) => <p>{p}</p>)}
      </div>
      <div class="split__media" data-reveal><Media label="DJ ReRe" alt="DJ ReRe, founder of MixHer, behind the decks" ratio="4 / 5" /></div>
    </div>
  </section>

  <CtaBand heading="Be part of the movement." primaryLabel="Join the DJ Network" primaryHref={site.joinUrl} secondaryLabel="Sponsor MixHer" secondaryHref={site.sponsorUrl} />
</Base>

<style>
  .center { display: block; text-align: center; }
  .mission { color: var(--muted); font-size: 1.2rem; max-width: 62ch; margin: 1.1rem auto 0; }
  .split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split.reverse { grid-template-columns: 1.1fr 0.9fr; }
  .split__text p { color: var(--muted); max-width: 54ch; }
  .story__line { font-family: var(--script); font-size: 1.9rem; color: var(--orchid-deep); margin-top: 1.1rem; line-height: 1; }
  @media (max-width: 840px) { .split, .split.reverse { grid-template-columns: 1fr; } .split__media { order: -1; } }
  .statgrid { text-align: center; }
  .statcard { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.4rem 0.4rem; }
  .statcard__n { font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 5vw, 3rem); line-height: 1; }
  .statcard__l { color: var(--muted); font-size: 0.8rem; }
  .spaced.center, .split .spaced { display: inline-block; }
</style>
