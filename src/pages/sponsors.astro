---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Media from '../components/Media.astro';
import { site, impact, sponsorBrands, sponsorVenues, partners } from '../data/site';
---
<Base title="Sponsors & Brands" description="Partner with The MixHer — align with music-forward audiences, activate inside high-energy events, and support women in music. Tax-deductible.">
  <PageHeader
    kicker="Sponsors & partners"
    title={`Put your brand<br/>inside the <span class='grad-o'>vibe.</span>`}
    lead="The MixHer connects forward-thinking brands with a passionate community of female DJs, creatives, and tastemakers — while advancing women in music."
  />

  <!-- What makes us different -->
  <section class="section-pad">
    <div class="wrap narrow" style="text-align:center">
      <p class="spaced center" data-reveal>Why partner</p>
      <h2 class="fancy" data-reveal>Relevance &amp; reach, with real impact.</h2>
      <p class="why__lead" data-reveal>
        We’re building talent, not just booking it — shifting the culture while creating dope vibes.
        For brands, that’s relevance and reach. For venues, it’s guaranteed energy, content, and revenue.
      </p>
    </div>
  </section>

  <!-- Impact stats -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="grid grid-4 impact">
        {impact.map((s) => (
          <div class="istat" data-reveal>
            <span class="istat__num grad">{s.num}</span>
            <span class="istat__label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Energy band -->
  <section class="section-pad">
    <div class="wrap">
      <div class="spband" data-reveal><Media src="/img/group1.jpg" alt="A packed MixHer event" ratio="21 / 9" /></div>
    </div>
  </section>

  <!-- For brands / venues -->
  <section class="section-pad">
    <div class="wrap">
      <div class="grid grid-2">
        <div class="card audience" data-reveal>
          <h3 class="audience__h grad">For Brands</h3>
          <ul class="audience__list">
            {sponsorBrands.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div class="card audience" data-reveal>
          <h3 class="audience__h grad-o">For Venues &amp; Media</h3>
          <ul class="audience__list">
            {sponsorVenues.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>
      <p class="tax" data-reveal>The MixHer is a minority woman-founded 501(c)(3) nonprofit. {site.taxLine}</p>
    </div>
  </section>

  <!-- Partners -->
  <section class="section-pad tint logos">
    <div class="wrap">
      <p class="spaced center" data-reveal>In good company</p>
      <div class="logos__row" data-reveal>
        {partners.map((name) => <span class="logos__item">{name}</span>)}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Let’s build something custom."
    sub="Tell us your goals and we’ll tailor a partnership that fits — from gifting bags to a fully branded activation."
    primaryLabel="Email the team"
    primaryHref={site.emailHref}
    secondaryLabel="See our events"
    secondaryHref="/events"
  />
</Base>

<style>
  .why__lead { color: var(--muted); font-size: 1.12rem; max-width: 62ch; margin: 1.2rem auto 0; }
  .center { display: inline-flex; justify-content: center; }
  .sec-head .spaced { display: block; }

  .impact { text-align: center; }
  .istat { display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 0.5rem; }
  .istat__num { font-family: var(--display); font-weight: 800; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1; }
  .istat__label { color: var(--muted); font-size: 0.85rem; }

  .spband { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); border: 1px solid var(--card-brd); }

  .audience { display: flex; flex-direction: column; gap: 0.8rem; }
  .audience__h { font-family: var(--display); font-weight: 800; font-size: 1.8rem; text-transform: uppercase; margin: 0; }
  .audience__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .audience__list li { color: var(--muted); font-size: 0.95rem; padding-left: 1.4rem; position: relative; }
  .audience__list li::before { content: '✦'; position: absolute; left: 0; color: var(--orange); }
  .tax { text-align: center; color: var(--dim); margin-top: 1.6rem; font-size: 0.9rem; }

  .logos__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2.4rem; margin-top: 1.6rem; }
  .logos__item { font-family: var(--display); font-weight: 800; font-size: clamp(1rem, 2.2vw, 1.5rem); text-transform: uppercase; color: var(--dim); }
</style>
