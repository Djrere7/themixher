---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
const forWho = ['Female DJs', 'Executives', 'Creatives', 'Brands', 'Venues', 'Media', 'Tastemakers'];
const formats = [
  { t: 'Curated conversations', b: 'Intentional discussions with the people shaping the industry.' },
  { t: 'Real introductions', b: 'Warm connections between DJs, brands, and decision-makers.' },
  { t: 'Industry access', b: 'A room where opportunities actually change hands.' },
];
---
<Base
  title="The Set Networking Series"
  fullTitle="The Set Networking Series | Music Industry Networking for DJs"
  description="The Set is MixHer’s networking series — intimate, industry-facing rooms where female DJs, executives, brands, venues, and tastemakers connect and get real access."
>
  <PageHeader
    kicker="The Set · The Networking Series"
    title={`Where connections<br/><span class='grad'>are made.</span>`}
    lead="The Set brings DJs, creatives, executives, brands, venues, and tastemakers into the same room for curated conversations, real introductions, and industry access."
  />

  <section class="section-pad">
    <div class="wrap split">
      <div class="split__media" data-reveal><Media src="/img/djl-decks.jpg" alt="Female DJs networking at The Set by MixHer" ratio="4 / 5" /></div>
      <div class="split__text" data-reveal>
        <p class="spaced">What The Set is</p>
        <h2 class="fancy">Access, made <span class="grad">intentional.</span></h2>
        <p>The Set is intimate, industry-facing, and valuable — a curated room where the right people meet on purpose. Talent is only half the game; The Set is the other half.</p>
        <p class="who-label">Who it’s for</p>
        <div class="chips">{forWho.map((w) => <span class="chip on">{w}</span>)}</div>
        <a href={site.bringUrl} class="btn btn-primary" style="margin-top:1.2rem">RSVP / Request an invite</a>
      </div>
    </div>
  </section>

  <section class="section-pad tint">
    <div class="wrap">
      <div class="sec-head"><p class="spaced" data-reveal>Inside the room</p><h2 class="display" data-reveal>What happens at The Set</h2></div>
      <div class="grid grid-3">
        {formats.map((f) => (
          <div class="card feat" data-reveal><h3 class="feat__t">{f.t}</h3><p class="feat__b">{f.b}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="wrap narrow" style="text-align:center">
      <p class="spaced center" data-reveal>Upcoming sessions</p>
      <h2 class="fancy" data-reveal>New dates dropping soon.</h2>
      <p class="lead" data-reveal>The Set runs in music-forward cities across the country. Join the newsletter or the DJ Network to be first to know — and reach out to co-host or partner on the next one.</p>
      <div class="ctas" data-reveal>
        <a href="#join-list" class="btn btn-primary">Join the newsletter</a>
        <a href="/contact" class="btn btn-ghost">Partner with The Set</a>
      </div>
    </div>
  </section>

  <CtaBand heading="Host The Set in your city." primaryLabel="Partner with us" primaryHref="/contact" secondaryLabel="Sponsor MixHer" secondaryHref={site.sponsorUrl} />
</Base>

<style>
  .sec-head .spaced { display: inline-block; margin-bottom: 0.7rem; }
  .center { display: block; text-align: center; }
  .split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split__text p { color: var(--muted); max-width: 52ch; }
  .who-label { font-family: var(--display); font-weight: 800; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin: 1.2rem 0 0.6rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 840px) { .split { grid-template-columns: 1fr; } .split__media { order: -1; max-width: 380px; } }
  .feat__t { font-family: var(--display); font-weight: 800; font-size: 1.35rem; text-transform: uppercase; margin: 0 0 0.4rem; color: var(--orchid-deep); }
  .feat__b { color: var(--muted); margin: 0; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 58ch; margin: 1rem auto 1.4rem; }
  .ctas { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
</style>
