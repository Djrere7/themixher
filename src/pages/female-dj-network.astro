---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import Form from '../components/Form.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, djBenefits } from '../data/site';
---
<Base
  title="Female DJ Network"
  fullTitle="Female DJ Network | Join the MixHer DJ Community"
  description="Join the MixHer DJ Network — a national community for female DJs with stages, gig-sharing, industry connections, resources, and brand opportunities. Request to join."
>
  <PageHeader
    kicker="The DJ Network"
    title={`The national hub for<br/><span class='grad'>female DJs.</span>`}
    lead="Join a national network created for female DJs looking for more stages, stronger industry connections, gig-sharing, resources, brand opportunities, and a community that moves together."
  />

  <!-- Benefits -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head"><p class="spaced" data-reveal>What you get</p>
      <h2 class="display" data-reveal>Everything a working DJ needs</h2></div>
      <div class="grid grid-3">
        {djBenefits.map((b) => (
          <div class="card feat" data-reveal>
            <h3 class="feat__t">{b.title}</h3>
            <p class="feat__b">{b.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How joining works (gated community) -->
  <section class="section-pad tint">
    <div class="wrap split">
      <div class="split__media" data-reveal><Media src="/img/dj-flowers.jpg" alt="Female DJ performing behind the decks at a MixHer event" ratio="4 / 5" /></div>
      <div class="split__text" data-reveal>
        <p class="spaced">How it works</p>
        <h2 class="fancy">A real community, <span class="grad">by request.</span></h2>
        <p>We keep the network real. Membership — including our private WhatsApp community — is by request and reviewed, so every room stays full of DJs who show up for each other.</p>
        <ol class="steps">
          <li><b>Request to join</b> — tell us about you below.</li>
          <li><b>We review</b> — we keep the community protected and vetted.</li>
          <li><b>You’re in</b> — approved DJs get the private invite, gig-sharing, and event access.</li>
        </ol>
        <a href="#join" class="btn btn-primary">Request to join</a>
      </div>
    </div>
  </section>

  <!-- Request form -->
  <section class="section-pad" id="join">
    <div class="wrap narrow">
      <div class="sec-head center"><p class="spaced" data-reveal>Request to join</p>
      <h2 class="fancy" data-reveal>Join the DJ Network</h2>
      <p class="center-sub" data-reveal>Every request is reviewed to protect the community. Approved DJs receive the private invite by email.</p></div>
      <div class="card formcard" data-reveal>
        <Form
          formName="Join the DJ Network"
          submit="Request to join"
          note="We review every request. You’ll hear from us by email — no one is auto-added."
          fields={[
            { name: 'name', label: 'Name / DJ name', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'city', label: 'City' },
            { name: 'instagram', label: 'Instagram handle' },
            { name: 'experience', label: 'DJ experience', type: 'select', options: ['Just starting', '1–3 years', '3–5 years', '5+ years', 'Professional / touring'] },
            { name: 'links', label: 'Mix / set links' },
            { name: 'about', label: 'Tell us about you & what you’re looking for', type: 'textarea', full: true },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Also -->
  <section class="section-pad tint">
    <div class="wrap">
      <div class="grid grid-3">
        <a href="/events" class="card mini" data-reveal><h3>Apply to perform</h3><p>Get considered for PLY, The Set, and MixHer events.</p></a>
        <a href="/sponsor-mixher" class="card mini" data-reveal><h3>Brand activations</h3><p>Submit for paid brand collaborations and gifting moments.</p></a>
        <a href="/first-spin-dj-bootcamp" class="card mini" data-reveal><h3>Give back</h3><p>Volunteer or mentor through First Spin DJ Bootcamp.</p></a>
      </div>
    </div>
  </section>

  <CtaBand heading="Not a DJ, but part of the culture?" sub="Join the newsletter for events, drops, and MixHer moments." primaryLabel="Join the newsletter" primaryHref="#join-list" secondaryLabel="Follow @themixher" secondaryHref={site.socials.instagram} />
</Base>

<style>
  .sec-head .spaced { display: inline-block; margin-bottom: 0.7rem; }
  .sec-head.center { text-align: center; }
  .center-sub { color: var(--muted); max-width: 52ch; margin: 0.6rem auto 0; }
  .feat { display: flex; flex-direction: column; gap: 0.4rem; }
  .feat__t { font-family: var(--display); font-weight: 800; font-size: 1.35rem; text-transform: uppercase; margin: 0; color: var(--orchid-deep); }
  .feat__b { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split__text p { color: var(--muted); max-width: 52ch; }
  .steps { margin: 1rem 0 1.4rem; padding-left: 1.2rem; color: var(--muted); display: flex; flex-direction: column; gap: 0.5rem; }
  .steps b { color: var(--ink); }
  @media (max-width: 840px) { .split { grid-template-columns: 1fr; } .split__media { order: -1; max-width: 420px; } }

  .formcard { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .mini h3 { font-family: var(--display); font-weight: 800; font-size: 1.3rem; text-transform: uppercase; margin: 0 0 0.3rem; }
  .mini p { color: var(--muted); margin: 0; font-size: 0.92rem; }
</style>
