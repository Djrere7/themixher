---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Media from '../components/Media.astro';
import Form from '../components/Form.astro';
import { site, founder } from '../data/site';
const photos = ['/img/dj-flowers.jpg', '/img/djl-decks.jpg', '/img/group1.jpg', '/img/fan.jpg'];
---
<Base
  title="Press Kit"
  fullTitle="MixHer Press Kit | Female DJ Nonprofit and Event Series"
  description="MixHer press kit — boilerplate, founder bio, approved photos, logos, and press contact for the national female DJ nonprofit and event series."
>
  <PageHeader
    kicker="Press & media"
    title={`MixHer <span class='grad'>press kit.</span>`}
    lead="Everything you need to cover MixHer — boilerplate, founder bio, approved photos, logos, and a direct press contact."
  />

  <!-- Boilerplate -->
  <section class="section-pad">
    <div class="wrap narrow">
      <div class="sec-head"><p class="spaced" data-reveal>Boilerplate</p><h2 class="display" data-reveal>About MixHer</h2></div>
      <p class="boiler" data-reveal>MixHer is a national 501(c)(3) nonprofit event series and DJ network founded in Miami by DJ ReRe. MixHer produces culture-forward events through its PLY party series, industry networking through The Set, a national DJ Network for female DJs, and youth DJ education through First Spin DJ Bootcamp. MixHer creates stages, industry access, and community for women behind the decks — setting the tone for the future of DJ culture.</p>
    </div>
  </section>

  <!-- Founder bio -->
  <section class="section-pad tint">
    <div class="wrap split">
      <div class="split__media" data-reveal><Media label="DJ ReRe" alt="DJ ReRe, founder of MixHer, behind the decks" ratio="4 / 5" /></div>
      <div class="split__text" data-reveal>
        <p class="spaced">Founder bio</p>
        <h2 class="fancy">DJ ReRe</h2>
        {founder.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Assets -->
  <section class="section-pad">
    <div class="wrap">
      <div class="sec-head"><p class="spaced" data-reveal>Approved photos &amp; logos</p><h2 class="display" data-reveal>Media assets</h2></div>
      <div class="gallery">{photos.map((src) => <Media src={src} alt="MixHer approved press photo — female DJ event" ratio="1 / 1" />)}</div>
      <p class="assets-note" data-reveal>Need high-resolution photos or logo files? Request them below and we’ll send the full press kit.</p>
    </div>
  </section>

  <!-- Interview request -->
  <section class="section-pad tint" id="request">
    <div class="wrap narrow">
      <div class="sec-head center"><p class="spaced" data-reveal>Press &amp; interviews</p><h2 class="fancy" data-reveal>Request an interview or assets</h2></div>
      <div class="card formcard" data-reveal>
        <Form
          formName="Press / interview request"
          submit="Send press request"
          note={`Press contact: ${site.email}`}
          fields={[
            { name: 'name', label: 'Name', required: true },
            { name: 'outlet', label: 'Outlet / publication', required: true },
            { name: 'email', label: 'Email', type: 'email', required: true },
            { name: 'need', label: 'What do you need?', type: 'select', options: ['Interview with DJ ReRe', 'High-res photos', 'Logo files', 'Event coverage', 'Other'] },
            { name: 'deadline', label: 'Deadline' },
            { name: 'details', label: 'Details', type: 'textarea', full: true },
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .sec-head .spaced { display: inline-block; margin-bottom: 0.7rem; }
  .sec-head.center { text-align: center; }
  .center { display: block; text-align: center; }
  .boiler { color: var(--muted); font-size: 1.05rem; line-height: 1.75; }
  .split { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split__text p { color: var(--muted); max-width: 54ch; }
  @media (max-width: 840px) { .split { grid-template-columns: 1fr; } .split__media { max-width: 340px; } }
  .gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.6rem, 1.5vw, 1rem); }
  @media (max-width: 620px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
  .assets-note { color: var(--muted); margin-top: 1.2rem; }
  .formcard { padding: clamp(1.5rem, 4vw, 2.5rem); }
</style>
