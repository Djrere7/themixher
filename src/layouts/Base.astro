---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = site.coreSentence,
  image = '/og.jpg',
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `The MixHer · ${site.tagline} — The Nonprofit Platform for Female DJs`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.themixher.org').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="generator" content="The MixHer" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="female DJs, women DJs, female DJ nonprofit, Miami female DJs, women in music, DJ community, female DJ events Miami, First Spin DJ Bootcamp, MixHer, Setting the Tone, brand activations Miami, DJ showcase" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0710" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? 'https://www.themixher.org').href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NGO',
      name: 'The MixHer',
      alternateName: 'MixHer Inc.',
      description: site.coreSentence,
      url: 'https://www.themixher.org',
      email: site.email,
      telephone: '+1-786-910-2799',
      slogan: 'Setting the Tone',
      foundingDate: '2023',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '1000 5th Street, Suite 200',
        addressLocality: 'Miami Beach',
        addressRegion: 'FL',
        postalCode: '33139',
        addressCountry: 'US',
      },
      areaServed: ['Miami', 'South Florida', 'United States'],
      sameAs: Object.values(site.socials),
    })} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a href="#main" class="sr-only">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = Array.from(document.querySelectorAll('[data-reveal]'));
      const reveal = (el: Element) => el.classList.add('in');
      const revealAll = () => els.forEach(reveal);

      // Fail-safe: if there is no working viewport height (some embedded/preview
      // contexts report 0) or no IntersectionObserver, show everything so content
      // can never get stuck hidden. Real browsers keep the scroll-in effect below.
      if (!('IntersectionObserver' in window) || !window.innerHeight) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -5% 0px' },
        );
        // Reveal anything already in/above the viewport (deep links, restored
        // scroll), observe the rest for the effect.
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) reveal(el);
          else io.observe(el);
        });
        // Last-resort safety net: on first user scroll, reveal anything on screen
        // that the observer somehow missed.
        const sweep = () => {
          els.forEach((el) => {
            if (!el.classList.contains('in') && el.getBoundingClientRect().top < window.innerHeight) reveal(el);
          });
        };
        window.addEventListener('scroll', sweep, { passive: true, once: true });
      }
    </script>
  </body>
</html>
