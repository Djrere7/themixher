---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;        // page name → "<title> | MixHer"
  fullTitle?: string;    // exact <title> override (SEO)
  description?: string;
  image?: string;
  schema?: object[];     // extra JSON-LD for the page
  keywords?: string;
}
const {
  title,
  fullTitle,
  description = 'MixHer is a national 501(c)(3) nonprofit and female DJ network — culture-forward events (PLY, The Set), industry access, and First Spin DJ Bootcamp.',
  image = '/og.jpg',
  schema = [],
  keywords = 'female DJs, women DJs, female DJ network, DJ nonprofit, DJ events Miami, Miami female DJs, national DJ event series, women behind the decks, DJ bootcamp, youth DJ lessons, DJ mentorship, music nonprofit, female DJ community, DJ networking event, female DJ party series',
} = Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} | ${site.name}` : 'MixHer | Female DJ Network, Events & Nonprofit DJ Bootcamp');
const origin = 'https://www.themixher.org';
const canonical = new URL(Astro.url.pathname, Astro.site ?? origin).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NonprofitOrganization',
  name: 'MixHer',
  alternateName: ['The MixHer', 'MIXHER INC.'],
  description: 'A national 501(c)(3) nonprofit event series and DJ network for female DJs — producing PLY parties, The Set networking, and First Spin DJ Bootcamp.',
  url: origin,
  email: site.email,
  logo: `${origin}/brand/mixher-logo.png`,
  slogan: 'Setting The Tone',
  foundingDate: '2023',
  founder: { '@type': 'Person', name: 'DJ ReRe' },
  legalName: site.legalName,
  nonprofitStatus: 'Nonprofit501c3',
  taxID: site.ein,
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, addressRegion: site.address.region, postalCode: site.address.postal, addressCountry: 'US' },
  areaServed: 'United States',
  knowsAbout: ['female DJs', 'DJ events', 'music industry networking', 'youth DJ education'],
  contactPoint: { '@type': 'ContactPoint', email: site.email, contactType: 'customer service' },
  sameAs: Object.values(site.socials),
};
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'DJ ReRe',
  jobTitle: 'Founder, MixHer · International DJ',
  worksFor: { '@type': 'Organization', name: 'MixHer' },
  description: 'International DJ with 20+ years of experience, founder of MixHer, and owner of REmixed Events.',
};
const allSchema = [orgSchema, personSchema, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="generator" content="MixHer" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    {site.gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.gaId}');`}></script>
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? origin).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? origin).href} />
    <meta name="twitter:site" content="@themixher" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <link rel="preload" href="/fonts/MonumentExtended-Ultrabold.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Poppins-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/kelin-eator.woff2" as="font" type="font/woff2" crossorigin />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = Array.from(document.querySelectorAll('[data-reveal]'));
      const reveal = (el: Element) => el.classList.add('in');
      const revealAll = () => els.forEach(reveal);
      if (!('IntersectionObserver' in window) || !window.innerHeight) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => { for (const e of entries) { if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); } } },
          { threshold: 0.1, rootMargin: '0px 0px -5% 0px' },
        );
        els.forEach((el) => { if (el.getBoundingClientRect().top < window.innerHeight) reveal(el); else io.observe(el); });
        const sweep = () => { els.forEach((el) => { if (!el.classList.contains('in') && el.getBoundingClientRect().top < window.innerHeight) reveal(el); }); };
        window.addEventListener('scroll', sweep, { passive: true, once: true });
      }
    </script>
  </body>
</html>
